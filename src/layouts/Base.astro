---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import Search from '../components/Search.astro';
import { SITE } from '../site.config';
import { checkReferences } from '../lib/songs';
import { TAXONOMY_KEYS } from '../lib/facets';
import { MAX_SCALE, MIN_SCALE, STORAGE_KEYS } from '../lib/reading';
import { PAGES, SONGS_JSON_URL, facetUrl } from '../lib/urls';

// Every page uses this layout, so a broken reference fails the build here.
await checkReferences();

interface Props {
  title?: string;
  description?: string;
  /** schema.org data for the page */
  jsonLd?: Record<string, unknown>;
  /** hide the header search button (the home page has its own) */
  bare?: boolean;
  /** og:type */
  type?: 'website' | 'music.song';
  noindex?: boolean;
}
const { title, description = SITE.description, jsonLd, bare = false, type = 'website', noindex = false } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.shortTitle}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const nav = [
  { href: PAGES.songs, label: 'Songs', match: [PAGES.songs] },
  { href: PAGES.browse, label: 'Browse', match: [PAGES.browse, ...TAXONOMY_KEYS.map((key) => facetUrl(key))] },
  { href: PAGES.glossary, label: 'Glossary', match: [PAGES.glossary] },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/json" href={SONGS_JSON_URL} title="Songbook data (JSON)" />
    <meta name="theme-color" content={SITE.themeColor} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:image" content={new URL(SITE.icon.src, Astro.site)} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script is:inline define:vars={{ keys: STORAGE_KEYS, minScale: MIN_SCALE, maxScale: MAX_SCALE }}>
      // Apply saved reading preferences before first paint so nothing flickers.
      // (Inline, so it can't import: src/scripts/song-page.ts saves them.)
      try {
        const html = document.documentElement;
        if (localStorage.getItem(keys.translation) === '0') html.classList.add('hide-translation');
        const scale = Number(localStorage.getItem(keys.lyricScale));
        if (scale) html.style.setProperty('--lyric-scale', String(Math.min(maxScale, Math.max(minScale, scale))));
      } catch {
        // Storage can be blocked (private mode, strict settings): keep the defaults.
      }
    </script>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip sr-only" href="#main">Skip to content</a>
    <div class="corda" aria-hidden="true"></div>
    <header class="site-header">
      <div class="wrap bar">
        <a href={PAGES.home} class="logo">
          <span class="wordmark">{SITE.shortTitle}</span>
          <span class="eyebrow sage">cantigas de capoeira</span>
        </a>
        <nav aria-label="Main">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={item.match.some((prefix) => path.startsWith(prefix)) ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
          {
            !bare && (
              <button class="search-btn" type="button" data-open-search aria-label="Search (/)">
                <Icon name="search" size={16} />
              </button>
            )
          }
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap foot">
        <p>
          {SITE.shortTitle} — an open songbook · lyrics &amp; translations{' '}
          <a href={SITE.licenseUrl}>{SITE.license}</a>
        </p>
        <p class="links">
          <a href={PAGES.about}>About &amp; open data</a>
          <a href={SONGS_JSON_URL}>JSON</a>
          <span>Iê, axé!</span>
        </p>
      </div>
    </footer>

    {
      !bare && (
        <dialog id="search-dialog" aria-label="Search songs">
          <div class="dialog-inner">
            <button class="icon-btn close" type="button" data-close aria-label="Close search">
              <Icon name="close" />
            </button>
            <Search id="dialog-q" />
          </div>
        </dialog>
      )
    }

    <script>
      if ('serviceWorker' in navigator && import.meta.env.PROD) {
        addEventListener('load', () =>
          navigator.serviceWorker
            .register('/sw.js')
            .catch((e: unknown) => console.warn('Offline mode is off: the service worker did not register.', e)),
        );
      }
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    padding-top: env(safe-area-inset-top);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    background: color-mix(in srgb, var(--bg) 96%, transparent);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
    view-transition-name: site-header;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px 32px;
    flex-wrap: wrap;
    padding-block: 18px 14px;
  }
  .logo {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-decoration: none;
    line-height: 1;
  }
  .wordmark {
    font: 600 24px/1 var(--font-display);
    letter-spacing: -0.01em;
    color: var(--gold);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
    font: 400 0.72rem/1 var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  nav a,
  .search-btn {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    color: var(--muted);
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }
  nav a:hover,
  .search-btn:hover {
    background: var(--surface);
    color: var(--text);
  }
  nav a[aria-current='page'] {
    background: var(--gold);
    color: var(--gold-ink);
  }
  .search-btn {
    justify-content: center;
    min-width: 44px;
    border: 0;
    background: none;
    cursor: pointer;
  }
  @media (max-width: 560px) {
    /* on a phone the two-row header would permanently cover the lyrics — let it scroll away */
    .site-header {
      position: static;
    }
    .bar {
      padding-block: 12px 10px;
    }
    nav a,
    .search-btn {
      padding: 6px 9px;
      min-height: 40px;
    }
    nav {
      letter-spacing: 0.1em;
    }
  }

  main {
    flex: 1;
    padding: 16px 0 72px;
  }

  .site-footer {
    padding-bottom: calc(24px + env(safe-area-inset-bottom));
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font: 400 var(--fs-micro)/1.6 var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .foot p {
    margin: 0;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 16px;
  }
  .foot a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    min-width: 44px;
    text-decoration: none;
  }
  .foot a:hover {
    color: var(--gold);
  }

  dialog {
    width: min(720px, 100vw);
    max-width: 100vw;
    max-height: 100dvh;
    margin: 0 auto;
    padding: 0;
    border: none;
    background: transparent;
    color: var(--text);
  }
  dialog::backdrop {
    background: color-mix(in srgb, var(--text) 30%, transparent);
    backdrop-filter: blur(4px);
  }
  dialog[open] {
    animation: drop 0.3s var(--ease-out);
  }
  @keyframes drop {
    from {
      opacity: 0;
      transform: translateY(-12px);
    }
  }
  .dialog-inner {
    position: relative;
    margin: calc(12px + env(safe-area-inset-top)) var(--gutter) 24px;
    padding: 56px 16px 16px;
    border-radius: var(--radius);
    background: var(--bg);
    border: 1px solid var(--line);
  }
  .dialog-inner :global(.song-grid) {
    grid-template-columns: 1fr;
    max-height: calc(100dvh - 240px);
    overflow-x: hidden;
    overflow-y: auto;
  }
  .close {
    position: absolute;
    top: 6px;
    right: 6px;
  }
</style>
