---
import Icon from './Icon.astro';
import { SITE } from '../site.config';

interface Recording {
  file: string;
  title?: string;
  performer?: string;
  recordedAt?: Date;
  source?: string;
  notes?: string;
  sync: boolean;
}
interface Props {
  recordings: Recording[];
  songTitle: string;
}
const { recordings, songTitle } = Astro.props;
const syncIndex = Math.max(0, recordings.findIndex((r) => r.sync));
const label = (r: Recording, i: number) =>
  r.title ?? r.performer ?? (r.recordedAt ? r.recordedAt.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' }) : `Recording ${i + 1}`);
const src = (f: string) => (/^https?:/.test(f) || f.startsWith('/') ? f : `/${f}`);
---

<div class="player-slot" data-player-slot>
<div
  class="player"
  data-player
  data-sync-index={syncIndex}
  data-title={songTitle}
  data-artist={SITE.groupName}
>
  <audio preload="metadata" src={src(recordings[0].file)}></audio>

  <button class="gourd" type="button" data-play aria-label="Play">
    <span class="gourd-shell"></span>
    <span class="gourd-mouth"></span>
    <span class="ico ico-play"><Icon name="play" size={28} /></span>
    <span class="ico ico-pause"><Icon name="pause" size={26} /></span>
    <span class="ripple"></span>
  </button>

  <div class="body">
    <div class="top">
      <span class="now-label" data-now-label>{label(recordings[0], 0)}</span>
      <span class="time"><span data-cur>0:00</span> / <span data-dur>–:––</span></span>
    </div>
    <div class="wire-wrap">
      <div class="wire" aria-hidden="true">
        <span class="wire-fill"></span>
        <span class="wire-buzz"></span>
      </div>
      <input type="range" min="0" max="1000" value="0" step="1" aria-label="Seek" data-seek-bar />
    </div>
    <div class="controls">
      <button type="button" class="chip" data-speed aria-label="Playback speed">1×</button>
      <button type="button" class="chip" data-loop aria-pressed="false" aria-label="Loop">
        <Icon name="loop" size={16} /> Loop
      </button>
      <a class="chip" data-download href={src(recordings[0].file)} download>
        <Icon name="download" size={16} /> <span class="sr-only">Download recording</span>
      </a>
    </div>
    {
      recordings.length > 1 && (
        <ul class="chips takes" aria-label="Recordings">
          {recordings.map((r, i) => (
            <li>
              <button
                type="button"
                class="chip"
                data-take={i}
                data-src={src(r.file)}
                data-label={label(r, i)}
                aria-pressed={i === 0 ? 'true' : 'false'}
              >
                {label(r, i)}
                {r.sync && <span class="count">♪ synced</span>}
              </button>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</div>
</div>

<script>
  import { initPlayer } from '../scripts/player';
  document.querySelectorAll<HTMLElement>('[data-player]').forEach(initPlayer);
</script>

<style>
  .player-slot {
    min-height: var(--slot-h, auto);
  }
  /* when you scroll down to read, the player docks to the bottom of the screen */
  .player:global(.docked) {
    position: fixed;
    z-index: 25;
    left: 50%;
    bottom: calc(12px + env(safe-area-inset-bottom));
    width: min(720px, calc(100vw - 24px));
    translate: -50% 0;
    padding: 10px 14px;
    gap: 12px;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    background: color-mix(in srgb, var(--surface-2) 92%, transparent);
    animation: dock 0.45s var(--ease-ginga);
  }
  .player:global(.docked) .gourd {
    width: 54px;
    height: 54px;
  }
  .player:global(.docked) .gourd-mouth {
    inset: 11px;
  }
  .player:global(.docked) .takes,
  .player:global(.docked) .controls {
    display: none;
  }
  .player:global(.docked) .wire-wrap {
    margin: 0;
  }
  @keyframes dock {
    from { transform: translateY(120%); }
  }
  .player {
    --amp: 0;
    display: flex;
    gap: 18px;
    align-items: center;
    padding: 16px 18px;
    border-radius: 24px;
    background:
      radial-gradient(120% 140% at 0% 50%, color-mix(in srgb, var(--gold) 14%, transparent), transparent 60%),
      color-mix(in srgb, var(--surface) 90%, transparent);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }

  /* the cabaça */
  .gourd {
    position: relative;
    flex: none;
    width: 76px;
    height: 76px;
    border: none;
    padding: 0;
    background: none;
    cursor: pointer;
    border-radius: 50%;
    transform: scale(calc(1 + var(--amp) * 0.14));
    transition: transform 70ms linear;
  }
  .gourd-shell {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(circle at 34% 30%, #f6cf86, #c98535 55%, #6b3c13);
    box-shadow: inset -6px -8px 14px rgba(0, 0, 0, 0.35), 0 8px 18px -6px rgba(0, 0, 0, 0.5);
  }
  .gourd-mouth {
    position: absolute;
    inset: 16px;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 40%, #3a210c, #1d0f04);
    box-shadow: inset 0 3px 8px rgba(0, 0, 0, 0.6);
  }
  .ico {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: #f6cf86;
  }
  .ico-play :global(svg) {
    translate: 2px 0;
  }
  .ico-pause,
  .player.playing .ico-play {
    display: none;
  }
  .player.playing .ico-pause {
    display: grid;
  }
  .ripple {
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 2px solid var(--gold);
    opacity: 0;
  }
  .player.playing .ripple {
    animation: ripple 1.6s ease-out infinite;
  }
  @keyframes ripple {
    from { opacity: 0.6; transform: scale(0.95); }
    to { opacity: 0; transform: scale(1.45); }
  }

  .body {
    flex: 1;
    min-width: 0;
  }
  .top {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 14px;
  }
  .now-label {
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .time {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* the arame (wire) as progress bar, the dobrão (coin) as thumb */
  .wire-wrap {
    position: relative;
    height: 30px;
    margin: 4px 0 6px;
  }
  .wire {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 2px;
    translate: 0 -50%;
    background: color-mix(in srgb, var(--text) 25%, transparent);
    border-radius: 2px;
  }
  .wire-fill {
    position: absolute;
    inset: 0;
    width: calc(var(--p, 0) * 100%);
    background: linear-gradient(90deg, var(--terra), var(--gold));
    border-radius: 2px;
  }
  .wire-buzz {
    position: absolute;
    inset: -1px 0;
    opacity: 0;
    background: color-mix(in srgb, var(--gold) 60%, transparent);
  }
  .player.playing .wire-buzz {
    animation: buzz 80ms linear infinite alternate;
  }
  @keyframes buzz {
    from { transform: translateY(-1.5px); opacity: 0.5; }
    to { transform: translateY(1.5px); opacity: 0.2; }
  }
  input[type='range'] {
    position: absolute;
    inset: 0;
    width: 100%;
    margin: 0;
    background: transparent;
    -webkit-appearance: none;
    appearance: none;
    cursor: pointer;
  }
  input[type='range']::-webkit-slider-runnable-track {
    height: 30px;
    background: transparent;
  }
  input[type='range']::-moz-range-track {
    background: transparent;
  }
  input[type='range']::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 18px;
    height: 18px;
    margin-top: 6px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #fbe7a6, #c9a33f 60%, #8a6a1b);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
  }
  input[type='range']::-moz-range-thumb {
    width: 18px;
    height: 18px;
    border: none;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #fbe7a6, #c9a33f 60%, #8a6a1b);
  }

  .controls {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .controls .chip {
    cursor: pointer;
    font-size: 13px;
    padding: 5px 10px;
    font-variant-numeric: tabular-nums;
  }
  .takes {
    margin-top: 10px;
  }
  .takes .chip {
    cursor: pointer;
    font-size: 13px;
  }
</style>
