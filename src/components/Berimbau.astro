---
/*
 * A berimbau: verga (bow), arame (wire), cabaça (gourd), dobrão (coin) and caxixi.
 * Add the class "playing" to an ancestor to make the wire vibrate; set --amp (0–1)
 * on an ancestor to pulse the gourd with the music.
 */
interface Props {
  class?: string;
  height?: number;
}
const { class: cls = '', height = 320 } = Astro.props;
---

<svg class:list={['berimbau', cls]} viewBox="0 0 140 420" height={height} aria-hidden="true">
  <defs>
    <linearGradient id="bw-wood" x1="0" x2="1">
      <stop offset="0" stop-color="#5b3a1e" />
      <stop offset=".5" stop-color="#a06a35" />
      <stop offset="1" stop-color="#6b4422" />
    </linearGradient>
    <radialGradient id="bw-gourd" cx=".35" cy=".35" r=".75">
      <stop offset="0" stop-color="#f2c47a" />
      <stop offset=".55" stop-color="#c47f33" />
      <stop offset="1" stop-color="#6e3f15" />
    </radialGradient>
    <linearGradient id="bw-caxixi" x1="0" x2="0" y1="0" y2="1">
      <stop offset="0" stop-color="#e3c48b" />
      <stop offset="1" stop-color="#9c7438" />
    </linearGradient>
  </defs>

  <g class="bw-sway">
    <!-- verga -->
    <path class="bw-verga" d="M52 14 Q 128 210 52 404" fill="none" stroke="url(#bw-wood)" stroke-width="8" stroke-linecap="round" />
    <!-- couro (leather tip) -->
    <path d="M50 10 l6 0 l-1 10 l-4 0 z" fill="#3b2412" />
    <!-- arame -->
    <g class="bw-wire">
      <line x1="52" y1="16" x2="52" y2="402" stroke="#d9d4c7" stroke-width="1.6" />
      <line class="ghost g1" x1="52" y1="16" x2="52" y2="402" stroke="#d9d4c7" stroke-width="1.2" />
      <line class="ghost g2" x1="52" y1="16" x2="52" y2="402" stroke="#d9d4c7" stroke-width="1.2" />
    </g>
    <!-- barbante tying wire to bow -->
    <path d="M52 316 L 90 318" stroke="#e8dcc0" stroke-width="2.4" stroke-linecap="round" />
    <!-- cabaça -->
    <g class="bw-gourd">
      <circle cx="104" cy="338" r="34" fill="url(#bw-gourd)" />
      <ellipse cx="80" cy="338" rx="7" ry="20" fill="#2a170a" opacity=".85" />
      <path d="M96 306 q 8 -6 16 0" stroke="#e8dcc0" stroke-width="2" fill="none" />
    </g>
    <!-- dobrão (coin) -->
    <g class="bw-coin">
      <circle cx="52" cy="268" r="9" fill="#c9a33f" stroke="#8a6a1b" stroke-width="1.5" />
      <circle cx="49" cy="265" r="2.5" fill="#f5e3a1" opacity=".8" />
    </g>
  </g>

  <!-- baqueta + caxixi -->
  <g class="bw-caxixi">
    <line x1="20" y1="168" x2="44" y2="214" stroke="#7a4d22" stroke-width="3.5" stroke-linecap="round" />
    <path d="M6 196 q -2 -30 12 -40 q 14 10 12 40 z" fill="url(#bw-caxixi)" stroke="#6e4f22" stroke-width="1.2" />
    <path d="M8 184 h18 M7 192 h20 M10 176 h14" stroke="#6e4f22" stroke-width="1" opacity=".55" />
    <ellipse cx="18" cy="197" rx="12" ry="3.5" fill="#4a2f14" />
  </g>
</svg>

<style>
  .berimbau {
    width: auto;
    overflow: visible;
    filter: drop-shadow(0 18px 24px rgba(0, 0, 0, 0.35));
  }
  .bw-sway {
    transform-origin: 52px 404px;
    animation: bw-sway 4.5s ease-in-out infinite;
  }
  @keyframes bw-sway {
    0%, 100% { transform: rotate(-2deg); }
    50% { transform: rotate(2.5deg); }
  }
  .bw-gourd {
    transform-origin: 104px 338px;
    transform: scale(calc(1 + var(--amp, 0) * 0.12));
    transition: transform 80ms linear;
  }
  .ghost {
    opacity: 0;
  }
  :global(.playing) .ghost {
    animation: bw-buzz 90ms linear infinite alternate;
  }
  :global(.playing) .g2 {
    animation-delay: -45ms;
  }
  @keyframes bw-buzz {
    from { opacity: 0.55; transform: translateX(-2.2px); }
    to { opacity: 0.25; transform: translateX(2.2px); }
  }
  .bw-caxixi {
    transform-origin: 40px 210px;
    animation: bw-shake 1.6s var(--ease-ginga, ease) infinite;
  }
  :global(.playing) .bw-caxixi {
    animation-duration: 0.5s;
  }
  @keyframes bw-shake {
    0%, 60%, 100% { transform: rotate(0); }
    70% { transform: rotate(-9deg); }
    82% { transform: rotate(6deg); }
  }
</style>
