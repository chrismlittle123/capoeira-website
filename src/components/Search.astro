---
import Icon from './Icon.astro';
import { getSongs, getTaxonomy } from '../lib/songs';

interface Props {
  inline?: boolean;
  filters?: boolean;
  syncUrl?: boolean;
  id?: string;
}
const { inline = false, filters = false, syncUrl = false, id = 'q' } = Astro.props;

const [songs, types] = await Promise.all([getSongs(), getTaxonomy('songTypes')]);
const counts = new Map<string, number>();
for (const s of songs) counts.set(s.data.type.id, (counts.get(s.data.type.id) ?? 0) + 1);
const typeFilters = types.filter((t) => counts.get(t.id));
---

<div class="search" data-search data-inline={inline || undefined} data-sync-url={syncUrl || undefined}>
  <form role="search" action="/" method="get">
    <label for={id} class="sr-only">Search songs</label>
    <span class="glass"><Icon name="search" size={24} /></span>
    <input
      id={id}
      name="q"
      type="search"
      placeholder="Sing any line…"
      autocomplete="off"
      autocapitalize="off"
      autocorrect="off"
      spellcheck="false"
      enterkeyhint="search"
    />
    <kbd class="hint" aria-hidden="true">/</kbd>
  </form>
  {
    filters && typeFilters.length > 1 && (
      <ul class="chips filters" aria-label="Filter by song type">
        {typeFilters.map((t) => (
          <li>
            <button type="button" class="chip" data-filter={t.id} data-label={t.data.plural} aria-pressed="false">
              {t.data.plural} <span class="count">{counts.get(t.id)}</span>
            </button>
          </li>
        ))}
      </ul>
    )
  }
  <p class="status" data-status aria-live="polite"></p>
  <ul class="song-grid stagger results" data-results></ul>
</div>

<script>
  import '../scripts/search';
</script>

<style>
  form {
    position: relative;
    display: flex;
    align-items: center;
  }
  .glass {
    position: absolute;
    left: 18px;
    color: var(--gold);
    pointer-events: none;
  }
  input {
    width: 100%;
    height: 60px;
    padding: 0 56px 0 52px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface) 80%, transparent);
    color: var(--text);
    font: 400 19px/1 var(--font-ui);
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
    -webkit-appearance: none;
    appearance: none;
  }
  input::placeholder {
    color: var(--muted);
  }
  input:focus {
    border-color: var(--gold);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--gold) 14%, transparent);
  }
  input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }
  .hint {
    position: absolute;
    right: 18px;
    padding: 2px 7px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    color: var(--muted);
    font: 400 12px var(--font-mono);
  }
  form:focus-within .hint,
  .has-text .hint {
    opacity: 0;
  }
  @media (hover: none) {
    .hint {
      display: none;
    }
  }
  .filters {
    margin-top: 14px;
  }
  .status {
    margin: 18px 0 12px;
    color: var(--muted);
    font: 400 var(--fs-small)/1.4 var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    min-height: 1em;
  }
  .status :global(.empty) {
    display: block;
    overflow-wrap: anywhere;
    padding: 28px 0;
    font: italic 400 24px/1.3 var(--font-display);
    letter-spacing: 0;
    text-transform: none;
    color: var(--text);
  }
  .status :global(.empty small) {
    display: block;
    margin-top: 8px;
    font: 400 15px/1.5 var(--font-ui);
    color: var(--muted);
  }
  .results :global(.why) {
    margin: 8px 0 0;
    font: 400 var(--fs-small)/1.4 var(--font-mono);
    color: var(--muted);
  }
  .results :global(.why mark),
  .results :global(.hook mark),
  .results :global(h3 mark) {
    background: var(--mark);
    color: inherit;
    border-radius: 2px;
    padding: 0 2px;
  }
</style>
