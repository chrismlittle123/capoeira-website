---
// A song's recordings behind one set of controls; the behaviour is in src/scripts/player.ts.
import Icon from './Icon.astro';
import type { Song } from '../lib/content/songs';
import { takesFor } from '../lib/player/playback';
import { MEDIA_ICON, youtubeThumbnailUrl } from '../lib/player/media';

interface Props {
  recordings: Song['data']['recordings'];
  songTitle: string;
}
const { recordings, songTitle } = Astro.props;
// the recording that line timestamps in the lyrics refer to
const syncIndex = Math.max(0, recordings.findIndex((r) => r.sync));
const takes = takesFor(recordings);
const first = takes[0];
const anyVideo = takes.some((t) => t.kind === 'youtube');
---

<div class="player-slot" data-player-slot>
  {
    anyVideo && (
      <div class="video" data-video hidden={first.kind !== 'youtube'}>
        <button type="button" class="poster" data-poster aria-label="Play video">
          <img
            src={first.kind === 'youtube' ? youtubeThumbnailUrl(first.videoId) : undefined}
            alt=""
            loading="lazy"
            decoding="async"
          />
          <span class="poster-play" aria-hidden="true">
            <Icon name="play" size={30} />
          </span>
        </button>
        <div class="frame" data-frame></div>
      </div>
    )
  }

  <div class="bar-holder" data-bar-holder>
    <div
      class="player"
      data-player
      data-sync-index={syncIndex}
      data-title={songTitle}
    >
      <audio preload="metadata" src={first.kind === 'audio' ? first.src : undefined}></audio>
      <script is:inline type="application/json" data-takes set:html={JSON.stringify(takes).replace(/</g, '\\u003c')} />

      <button class="gourd" type="button" data-play aria-label="Play">
        <span class="gourd-shell"></span>
        <span class="gourd-mouth"></span>
        <span class="ico ico-play"><Icon name="play" size={28} /></span>
        <span class="ico ico-pause"><Icon name="pause" size={26} /></span>
        <span class="ripple"></span>
      </button>

      <div class="body">
        <div class="top">
          <span class="now-label" data-now-label>
            {first.kind === 'youtube' && <span class="yt-badge">YouTube</span>}
            {first.label}
          </span>
          <span class="time"><span data-cur>0:00</span> / <span data-dur>–:––</span></span>
        </div>
        <div class="wire-wrap">
          <div class="wire" aria-hidden="true">
            <span class="wire-fill"></span>
            <span class="wire-buzz"></span>
          </div>
          <input type="range" min="0" max="1000" value="0" step="1" aria-label="Seek" aria-valuetext="0:00" data-seek-bar />
        </div>
        <div class="controls">
          <button type="button" class="chip" data-speed title="Playback speed">
            <span class="sr-only">Speed</span><span data-speed-label>1×</span>
          </button>
          <button type="button" class="chip" data-loop aria-pressed="false">
            <Icon name="loop" size={16} /> Loop
          </button>
          <a class="chip" data-download href={first.src} download hidden={first.kind !== 'audio'} aria-label="Download recording">
            <Icon name="download" size={16} />
          </a>
          <a class="chip" data-youtube-link href={first.src} target="_blank" rel="noopener" hidden={first.kind !== 'youtube'}>
            Open on YouTube
          </a>
        </div>
        {
          takes.length > 1 && (
            <ul class="chips takes" aria-label="Recordings">
              {takes.map((t, i) => (
                <li>
                  <button type="button" class="chip" data-take={i} aria-pressed={i === 0 ? 'true' : 'false'}>
                    {MEDIA_ICON[t.kind]} {t.label}
                    {i === syncIndex && recordings[i].sync && <span class="count">synced</span>}
                  </button>
                </li>
              ))}
            </ul>
          )
        }
        <p class="error" data-error role="status" hidden></p>
      </div>
    </div>
  </div>
</div>

<script>
  import { initPlayer } from '../scripts/player';
  document.querySelectorAll<HTMLElement>('[data-player]').forEach(initPlayer);
</script>

<style>
  .player-slot {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
  }
  .bar-holder {
    min-height: var(--slot-h, auto);
  }

  /* ── YouTube: a lightweight poster until someone presses play ── */
  .video {
    position: relative;
    width: 100%;
    max-width: 760px;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--text);
  }
  .video[hidden] {
    display: none;
  }
  .poster {
    position: absolute;
    z-index: 1;
    inset: 0;
    padding: 0;
    border: 0;
    background: #000;
    cursor: pointer;
  }
  .poster img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.85;
    transition: transform 0.6s var(--ease-out), opacity 0.3s;
  }
  .poster:hover img {
    transform: scale(1.03);
    opacity: 1;
  }
  .poster-play {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 76px;
    height: 76px;
    translate: -50% -50%;
    border-radius: 50%;
    color: var(--gold-ink);
    background: var(--gold);
    box-shadow: 0 0 0 8px color-mix(in srgb, var(--bg) 35%, transparent);
    transition: transform 0.35s var(--ease-ginga);
  }
  .poster-play :global(svg) {
    translate: 2px 0;
  }
  .poster:hover .poster-play {
    transform: scale(1.08);
  }
  .frame {
    position: absolute;
    inset: 0;
  }
  /* until a video is loaded the (empty) frame must not sit on top of the poster
     and swallow taps — the poster is what starts playback */
  .frame:empty {
    display: none;
  }
  .poster[hidden] {
    display: none;
  }
  .frame :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }
  .yt-badge {
    margin-right: 6px;
    padding: 1px 6px;
    border-radius: var(--radius-sm);
    background: var(--terra);
    color: #fff;
    font: 700 var(--fs-micro)/1.4 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    vertical-align: 1px;
  }

  /* when you scroll down to read, the player docks to the bottom of the screen */
  .player:global(.docked) {
    position: fixed;
    z-index: 25;
    left: 50%;
    bottom: calc(12px + env(safe-area-inset-bottom));
    width: min(720px, calc(100vw - 24px));
    translate: -50% 0;
    padding: 10px 14px;
    gap: 12px;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    background: color-mix(in srgb, var(--surface) 94%, transparent);
    border-color: var(--gold);
    box-shadow: 0 10px 30px -14px rgba(22, 48, 41, 0.45);
    animation: dock 0.45s var(--ease-ginga);
  }
  .player:global(.docked) .gourd {
    width: 54px;
    height: 54px;
  }
  .player:global(.docked) .gourd-mouth {
    inset: 11px;
  }
  .player:global(.docked) .takes,
  .player:global(.docked) .controls,
  .player:global(.docked) .error {
    display: none;
  }
  .player:global(.docked) .wire-wrap {
    margin: 0;
  }
  @keyframes dock {
    from { transform: translateY(120%); }
  }

  .player {
    --amp: 0;
    display: flex;
    gap: 18px;
    align-items: center;
    padding: 16px 20px;
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    border: 1px solid var(--line);
  }

  /* the cabaça */
  .gourd {
    position: relative;
    flex: none;
    width: 76px;
    height: 76px;
    border: none;
    padding: 0;
    background: none;
    cursor: pointer;
    border-radius: 50%;
    transform: scale(calc(1 + var(--amp) * 0.14));
    transition: transform 70ms linear;
  }
  .gourd:disabled {
    cursor: not-allowed;
    filter: grayscale(0.8);
    opacity: 0.6;
  }
  .gourd-shell {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--gold);
  }
  .gourd-mouth {
    position: absolute;
    inset: 16px;
    border-radius: 50%;
    background: var(--text);
  }
  .ico {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--bg);
  }
  .ico-play :global(svg) {
    translate: 2px 0;
  }
  .ico-pause,
  .player:global(.playing) .ico-play {
    display: none;
  }
  .player:global(.playing) .ico-pause {
    display: grid;
  }
  .ripple {
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 2px solid var(--gold);
    opacity: 0;
  }
  .player:global(.playing) .ripple {
    animation: ripple 1.6s ease-out infinite;
  }
  @keyframes ripple {
    from { opacity: 0.6; transform: scale(0.95); }
    to { opacity: 0; transform: scale(1.45); }
  }

  .body {
    flex: 1;
    min-width: 0;
  }
  .top {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 15px;
  }
  .now-label {
    min-width: 0;
    font-family: var(--font-display);
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .time {
    color: var(--muted);
    font: 400 0.75rem/1.6 var(--font-mono);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* the arame (wire) as progress bar, the dobrão (coin) as thumb */
  .wire-wrap {
    position: relative;
    height: 44px;
    margin: 4px 0 6px;
  }
  .wire {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 2px;
    translate: 0 -50%;
    background: var(--line);
    border-radius: 0;
  }
  .wire-fill {
    position: absolute;
    inset: 0;
    width: calc(var(--p, 0) * 100%);
    background: var(--gold);
  }
  .wire-buzz {
    position: absolute;
    inset: -1px 0;
    opacity: 0;
    background: color-mix(in srgb, var(--gold) 60%, transparent);
  }
  .player:global(.playing) .wire-buzz {
    animation: buzz 80ms linear infinite alternate;
  }
  @keyframes buzz {
    from { transform: translateY(-1.5px); opacity: 0.5; }
    to { transform: translateY(1.5px); opacity: 0.2; }
  }
  input[type='range'] {
    position: absolute;
    inset: 0;
    width: 100%;
    margin: 0;
    background: transparent;
    -webkit-appearance: none;
    appearance: none;
    cursor: pointer;
  }
  input[type='range']::-webkit-slider-runnable-track {
    height: 44px;
    background: transparent;
  }
  input[type='range']::-moz-range-track {
    background: transparent;
  }
  input[type='range']::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 20px;
    height: 20px;
    margin-top: 12px;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 0 3px var(--bg);
  }
  input[type='range']::-moz-range-thumb {
    width: 20px;
    height: 20px;
    border: none;
    border-radius: 50%;
    background: var(--gold);
  }

  .controls {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .controls .chip {
    min-height: 40px;
    min-width: 44px;
    justify-content: center;
    cursor: pointer;
    font-size: 13px;
    padding: 5px 12px;
    font-variant-numeric: tabular-nums;
  }
  .controls .chip[hidden] {
    display: none;
  }
  .takes {
    margin-top: 10px;
  }
  .takes .chip {
    cursor: pointer;
    font-size: 13px;
    white-space: normal;
    text-align: left;
  }
  .error {
    margin: 8px 0 0;
    font-size: 14px;
    color: var(--terra);
  }
  @media (max-width: 480px) {
    .player {
      gap: 12px;
      padding: 14px;
    }
    .gourd {
      width: 60px;
      height: 60px;
    }
    .gourd-mouth {
      inset: 12px;
    }
    /* let the recording name wrap instead of being cut to "YouTube …" */
    .now-label {
      flex: 1;
      overflow: visible;
      text-overflow: clip;
      white-space: normal;
      line-height: 1.3;
    }
    /* name on its own line(s), time underneath — they don't both fit on a phone */
    .top {
      flex-direction: column;
      gap: 2px;
    }
  }
</style>
