---
import { getCollection } from 'astro:content';
import type { LyricSection } from '../lib/lyrics';

interface Props {
  sections: LyricSection[];
}
const { sections } = Astro.props;

// Link glossary words inside lyrics (longest forms first so "volta do mundo" beats "mundo").
const glossary = await getCollection('glossary');
const forms = glossary
  .flatMap((g) => [g.data.term, ...g.data.forms].map((f) => ({ f, id: g.id })))
  .sort((a, b) => b.f.length - a.f.length);
const byForm = new Map(forms.map(({ f, id }) => [f.toLocaleLowerCase('pt'), id]));
const re = forms.length
  ? new RegExp(
      `(?<![\\p{L}])(${forms.map(({ f }) => f.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|')})(?![\\p{L}])`,
      'giu',
    )
  : null;
const used = new Set<string>();

const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
function linkGlossary(text: string) {
  if (!re) return esc(text);
  let out = '';
  let last = 0;
  for (const m of text.matchAll(re)) {
    const id = byForm.get(m[0].toLocaleLowerCase('pt'));
    if (!id || used.has(id)) continue; // explain each word once, where it first appears
    used.add(id);
    out +=
      esc(text.slice(last, m.index)) +
      `<span class="gloss" role="button" tabindex="0" aria-expanded="false" aria-controls="gloss-pop" data-term="${id}">${esc(m[0])}</span>`;
    last = m.index! + m[0].length;
  }
  return out + esc(text.slice(last));
}

const fmt = (t: number) => `${Math.floor(t / 60)}:${String(Math.floor(t % 60)).padStart(2, '0')}`;
const rendered = sections.map((s) => ({
  ...s,
  stanzas: s.stanzas.map((st) => st.map((l) => ({ ...l, html: linkGlossary(l.text) }))),
}));
const usedTerms = glossary.filter((g) => used.has(g.id));
---

<div class="lyrics" data-lyrics>
  {
    rendered.map((s, si) => (
      <section class:list={['part', s.role]} style={`--i:${si}`}>
        <h2 class="label">
          {s.role === 'coro' ? <span class="who">Coro</span> : <span class="who">{s.label}</span>}
          {s.role === 'coro' && s.label.toLowerCase() !== 'coro' && <span class="sub">{s.label}</span>}
        </h2>
        {s.stanzas.map((st) => (
          <div class="stanza">
            {st.map((l) => (
              <p class:list={['line', l.coro && 'coro-line']} data-time={l.time}>
                {l.time != null && (
                  <button type="button" class="seek" data-seek={l.time} aria-label={`Play from ${fmt(l.time)}`}>
                    {fmt(l.time)}
                  </button>
                )}
                <span class="pt" lang="pt-BR" set:html={l.html} />
                {l.translation && (
                  <span class="tr" lang="en">
                    {l.translation}
                  </span>
                )}
              </p>
            ))}
          </div>
        ))}
      </section>
    ))
  }
</div>

{
  usedTerms.length > 0 && (
    <script is:inline type="application/json" id="glossary-data" set:html={JSON.stringify(Object.fromEntries(usedTerms.map((g) => [g.id, g.data]))).replace(/</g, '\\u003c')} />
  )
}
<div class="gloss-pop" id="gloss-pop" aria-live="polite" hidden></div>

<script>
  const data = JSON.parse(document.querySelector('#glossary-data')?.textContent || '{}');
  const pop = document.querySelector<HTMLElement>('.gloss-pop')!;
  let current: HTMLElement | null = null;
  const hide = () => {
    pop.hidden = true;
    current?.setAttribute('aria-expanded', 'false');
    current = null;
  };
  document.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('.gloss-pop')) return;
    const btn = (e.target as HTMLElement).closest<HTMLElement>('.gloss');
    if (!btn) return hide();
    if (btn === current) return hide();
    const g = data[btn.dataset.term!];
    if (!g) return;
    pop.innerHTML = '';
    const b = document.createElement('strong');
    b.textContent = g.term;
    const p = document.createElement('span');
    p.textContent = g.definition;
    const more = document.createElement('a');
    more.href = `/glossary/#${btn.dataset.term}`;
    more.textContent = 'All words →';
    pop.append(b, p, more);
    pop.hidden = false;
    const r = btn.getBoundingClientRect();
    const w = pop.offsetWidth;
    const h = pop.offsetHeight;
    const vw = document.documentElement.clientWidth; // excludes the scrollbar
    pop.style.left = `${Math.max(12, Math.min(vw - w - 12, r.left + r.width / 2 - w / 2)) + scrollX}px`;
    // open above the word when there isn't room below
    const below = r.bottom + 8 + h < innerHeight || r.top - 8 - h < 0;
    pop.style.top = `${(below ? r.bottom + 8 : r.top - 8 - h) + scrollY}px`;
    current?.setAttribute('aria-expanded', 'false');
    current = btn;
    btn.setAttribute('aria-expanded', 'true');
  });
  addEventListener('resize', hide);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') hide();
    const el = e.target as HTMLElement;
    if ((e.key === 'Enter' || e.key === ' ') && el.classList?.contains('gloss')) {
      e.preventDefault();
      el.click();
    }
  });
</script>

<style>
  .lyrics {
    font-size: calc(var(--lyric-scale) * 1rem);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .part {
    position: relative;
    padding: 16px 20px 14px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface) 60%, transparent);
    animation: rise 0.55s var(--ease-out) both;
    animation-delay: calc(min(var(--i), 12) * 40ms);
  }
  /* Call & response: the lead sings from one side of the roda, the coro answers from the other. */
  .part.solo {
    margin-right: clamp(0px, 6vw, 64px);
    border-left: 3px solid var(--text);
  }
  .part.coro {
    margin-left: clamp(0px, 6vw, 64px);
    border-left: 3px solid var(--coro);
    background: color-mix(in srgb, var(--gold) 6%, var(--surface));
  }
  .label {
    display: flex;
    gap: 8px;
    align-items: baseline;
    margin-bottom: 8px;
    font: 400 0.62rem/1 var(--font-mono);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .coro .label {
    color: var(--coro);
  }
  .label .sub {
    letter-spacing: 0.1em;
  }
  .stanza + .stanza {
    margin-top: 16px;
  }
  .line {
    position: relative;
    margin: 0;
    padding: 4px 0;
    transition: opacity 0.3s;
  }
  .pt {
    display: block;
    font: 500 1.5em/1.28 var(--font-display);
    color: var(--solo);
  }
  .coro .pt,
  .coro-line .pt {
    color: var(--coro);
    font-weight: 600;
  }
  /* the coro answering inside a solo section */
  .coro-line {
    margin-left: clamp(16px, 6vw, 48px);
    padding-left: 12px;
    border-left: 2px solid color-mix(in srgb, var(--gold) 40%, transparent);
  }
  .tr {
    display: block;
    margin-top: 2px;
    font: 400 0.95em/1.4 var(--font-ui);
    color: var(--muted);
  }
  :global(.hide-translation) .tr {
    display: none;
  }
  .seek {
    float: right;
    min-width: 44px;
    min-height: 32px;
    margin: 2px 0 0 8px;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    background: transparent;
    color: var(--muted);
    font: 400 0.68rem/1.4 var(--font-mono);
    cursor: pointer;
  }
  .seek:hover {
    color: var(--gold);
    border-color: var(--gold);
  }

  /* karaoke: the line being sung */
  :global(.synced) .line {
    opacity: 0.45;
  }
  :global(.synced) .line:global(.now) {
    opacity: 1;
  }
  .line:global(.now)::before {
    content: '';
    position: absolute;
    left: -21px;
    top: 4px;
    bottom: 4px;
    width: 3px;
    background: var(--terra);
  }
  .coro-line:global(.now)::before {
    left: -2px;
  }

  .pt :global(.gloss) {
    cursor: help;
    text-decoration: underline dotted color-mix(in srgb, currentColor 50%, transparent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }
  .pt :global(.gloss:focus-visible) {
    outline: 2px solid var(--gold);
    border-radius: 2px;
  }
  .gloss-pop {
    position: absolute;
    z-index: 30;
    max-width: min(320px, calc(100vw - 24px));
    padding: 12px 14px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--gold);
    box-shadow: 0 8px 24px -12px rgba(22, 48, 41, 0.35);
    font-size: 15px;
    line-height: 1.5;
    animation: rise 0.2s var(--ease-out);
  }
  .gloss-pop :global(span) {
    display: block;
  }
  .gloss-pop :global(a) {
    display: inline-block;
    margin-top: 8px;
    font: 400 0.62rem/1.4 var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
  }
  .gloss-pop :global(a:hover) {
    color: var(--gold);
  }
  .gloss-pop :global(strong) {
    display: block;
    font: 600 19px/1.2 var(--font-display);
    color: var(--gold);
  }
</style>
