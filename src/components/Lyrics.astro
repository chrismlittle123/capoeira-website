---
import { getCollection } from 'astro:content';
import type { LyricSection } from '../lib/lyrics';

interface Props {
  sections: LyricSection[];
}
const { sections } = Astro.props;

// Link glossary words inside lyrics (longest forms first so "volta do mundo" beats "mundo").
const glossary = await getCollection('glossary');
const forms = glossary
  .flatMap((g) => [g.data.term, ...g.data.forms].map((f) => ({ f, id: g.id })))
  .sort((a, b) => b.f.length - a.f.length);
const byForm = new Map(forms.map(({ f, id }) => [f.toLocaleLowerCase('pt'), id]));
const re = forms.length
  ? new RegExp(
      `(?<![\\p{L}])(${forms.map(({ f }) => f.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|')})(?![\\p{L}])`,
      'giu',
    )
  : null;
const used = new Set<string>();

const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
function linkGlossary(text: string) {
  if (!re) return esc(text);
  let out = '';
  let last = 0;
  for (const m of text.matchAll(re)) {
    const id = byForm.get(m[0].toLocaleLowerCase('pt'));
    if (!id) continue;
    used.add(id);
    out += esc(text.slice(last, m.index)) + `<span class="gloss" role="button" tabindex="0" aria-expanded="false" data-term="${id}">${esc(m[0])}</span>`;
    last = m.index! + m[0].length;
  }
  return out + esc(text.slice(last));
}

const fmt = (t: number) => `${Math.floor(t / 60)}:${String(Math.floor(t % 60)).padStart(2, '0')}`;
const rendered = sections.map((s) => ({
  ...s,
  stanzas: s.stanzas.map((st) => st.map((l) => ({ ...l, html: linkGlossary(l.text) }))),
}));
const usedTerms = glossary.filter((g) => used.has(g.id));
---

<div class="lyrics" data-lyrics>
  {
    rendered.map((s, si) => (
      <section class:list={['part', s.role]} style={`--i:${si}`}>
        <h2 class="label">
          {s.role === 'coro' ? <span class="who">Coro</span> : <span class="who">{s.label}</span>}
          {s.role === 'coro' && s.label.toLowerCase() !== 'coro' && <span class="sub">{s.label}</span>}
        </h2>
        {s.stanzas.map((st) => (
          <div class="stanza">
            {st.map((l) => (
              <p class="line" data-time={l.time}>
                {l.time != null && (
                  <button type="button" class="seek" data-seek={l.time} aria-label={`Play from ${fmt(l.time)}`}>
                    {fmt(l.time)}
                  </button>
                )}
                <span class="pt" lang="pt-BR" set:html={l.html} />
                {l.translation && (
                  <span class="tr" lang="en">
                    {l.translation}
                  </span>
                )}
              </p>
            ))}
          </div>
        ))}
      </section>
    ))
  }
</div>

{
  usedTerms.length > 0 && (
    <script is:inline type="application/json" id="glossary-data" set:html={JSON.stringify(Object.fromEntries(usedTerms.map((g) => [g.id, g.data]))).replace(/</g, '\\u003c')} />
  )
}
<div class="gloss-pop" role="tooltip" hidden></div>

<script>
  const data = JSON.parse(document.querySelector('#glossary-data')?.textContent || '{}');
  const pop = document.querySelector<HTMLElement>('.gloss-pop')!;
  let current: HTMLElement | null = null;
  const hide = () => {
    pop.hidden = true;
    current?.setAttribute('aria-expanded', 'false');
    current = null;
  };
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('.gloss');
    if (!btn) return hide();
    if (btn === current) return hide();
    const g = data[btn.dataset.term!];
    if (!g) return;
    pop.innerHTML = '';
    const b = document.createElement('strong');
    b.textContent = g.term;
    const p = document.createElement('span');
    p.textContent = g.definition;
    pop.append(b, p);
    pop.hidden = false;
    const r = btn.getBoundingClientRect();
    const w = pop.offsetWidth;
    pop.style.left = `${Math.max(12, Math.min(innerWidth - w - 12, r.left + r.width / 2 - w / 2))}px`;
    pop.style.top = `${r.bottom + scrollY + 8}px`;
    current?.setAttribute('aria-expanded', 'false');
    current = btn;
    btn.setAttribute('aria-expanded', 'true');
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') hide();
    const el = e.target as HTMLElement;
    if ((e.key === 'Enter' || e.key === ' ') && el.classList?.contains('gloss')) {
      e.preventDefault();
      el.click();
    }
  });
</script>

<style>
  .lyrics {
    font-size: calc(var(--lyric-scale) * 1rem);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .part {
    position: relative;
    padding: 16px 20px 14px;
    border-radius: var(--radius);
    animation: rise 0.6s var(--ease-out) both;
    animation-delay: calc(min(var(--i), 12) * 40ms);
  }
  /* Call & response: the lead sings from one side of the roda, the coro answers from the other. */
  .part.solo {
    margin-right: clamp(0px, 8vw, 72px);
    background: color-mix(in srgb, var(--surface) 80%, transparent);
    border: 1px solid var(--line);
    border-top-left-radius: 6px;
  }
  .part.coro {
    margin-left: clamp(0px, 8vw, 72px);
    background: color-mix(in srgb, var(--gold) 11%, var(--surface));
    border: 1px solid color-mix(in srgb, var(--gold) 30%, transparent);
    border-top-right-radius: 6px;
  }
  .label {
    display: flex;
    gap: 8px;
    align-items: baseline;
    margin-bottom: 6px;
    font: 600 11px/1 var(--font-ui);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .coro .label {
    color: var(--coro);
  }
  .label .sub {
    letter-spacing: 0.04em;
    text-transform: none;
    font-weight: 400;
  }
  .stanza + .stanza {
    margin-top: 14px;
  }
  .line {
    position: relative;
    margin: 0;
    padding: 4px 0;
    transition: transform 0.35s var(--ease-ginga), opacity 0.3s;
  }
  .pt {
    display: block;
    font: 500 1.45em/1.3 var(--font-display);
    font-variation-settings: 'SOFT' 100, 'opsz' 48;
    color: var(--solo);
  }
  .coro .pt {
    color: var(--coro);
    font-weight: 600;
  }
  .tr {
    display: block;
    margin-top: 2px;
    font: italic 400 0.98em/1.35 var(--font-display);
    color: var(--muted);
  }
  :global(.hide-translation) .tr {
    display: none;
  }
  .seek {
    float: right;
    margin: 6px 0 0 8px;
    padding: 2px 8px;
    border-radius: 99px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--faint);
    font: 12px/1.4 var(--font-ui);
    font-variant-numeric: tabular-nums;
    cursor: pointer;
  }
  .seek:hover {
    color: var(--gold);
    border-color: var(--gold);
  }

  /* karaoke: the line being sung */
  :global(.synced) .line {
    opacity: 0.55;
  }
  :global(.synced) .line:global(.now) {
    opacity: 1;
    transform: translateX(6px) scale(1.02);
  }
  .line:global(.now) .pt {
    text-shadow: 0 0 22px color-mix(in srgb, var(--gold) 55%, transparent);
  }
  .line:global(.now)::before {
    content: '';
    position: absolute;
    left: -14px;
    top: 12px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gold);
    animation: beat 0.6s ease-in-out infinite alternate;
  }
  @keyframes beat {
    to { transform: scale(1.6); }
  }

  .pt :global(.gloss) {
    cursor: help;
    text-decoration: underline dotted color-mix(in srgb, currentColor 55%, transparent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }
  .pt :global(.gloss:focus-visible) {
    outline: 2px solid var(--gold);
    border-radius: 4px;
  }
  .gloss-pop {
    position: absolute;
    z-index: 30;
    max-width: min(320px, calc(100vw - 24px));
    padding: 12px 14px;
    border-radius: 14px;
    background: var(--surface-3);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    font-size: 15px;
    line-height: 1.45;
    animation: rise 0.25s var(--ease-out);
  }
  .gloss-pop :global(strong) {
    display: block;
    font-family: var(--font-display);
    font-size: 18px;
    color: var(--gold);
  }
</style>
