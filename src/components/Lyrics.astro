---
// The lyrics, line by line with translations and timestamps, with glossary words linked to a popover
// (src/scripts/glossary-popover.ts).
import { getCollection } from 'astro:content';
import type { LyricSection } from '../lib/lyrics/lyrics';
import { GLOSS_POPOVER_ID, glossaryLinker } from '../lib/lyrics/glossary-links';
import { formatTime } from '../lib/player/media';
import { LOCALE } from '../lib/normalize';

interface Props {
  sections: LyricSection[];
}
const { sections } = Astro.props;

// Link glossary words inside lyrics, each once, where it first appears.
const glossary = await getCollection('glossary');
const { link, used } = glossaryLinker(glossary.map((g) => ({ id: g.id, forms: [g.data.term, ...g.data.forms] })));

const rendered = sections.map((s) => ({
  ...s,
  stanzas: s.stanzas.map((st) => st.map((l) => ({ ...l, html: link(l.text) }))),
}));
const usedTerms = glossary.filter((g) => used.has(g.id));
// The linked words' entries for the popover, with "<" escaped so the JSON can't end the script element early.
const glossaryJson = JSON.stringify(Object.fromEntries(usedTerms.map((g) => [g.id, g.data]))).replace(/</g, '\\u003c');
---

<div class="lyrics" data-lyrics>
  {
    rendered.map((s, si) => (
      <section class:list={['part', s.role]} style={`--i:${si}`}>
        <h2 class="label">
          {s.role === 'coro' ? <span class="who">Coro</span> : <span class="who">{s.label}</span>}
          {s.role === 'coro' && s.label.toLowerCase() !== 'coro' && <span class="sub">{s.label}</span>}
        </h2>
        {s.stanzas.map((st) => (
          <div class="stanza">
            {st.map((l) => (
              <p class:list={['line', l.coro && 'coro-line']} data-time={l.time}>
                {l.time != null && (
                  <button type="button" class="seek" data-seek={l.time} aria-label={`Play from ${formatTime(l.time)}`}>
                    {formatTime(l.time)}
                  </button>
                )}
                <span class="pt" lang={LOCALE} set:html={l.html} />
                {l.translation && (
                  <span class="tr" lang="en">
                    {l.translation}
                  </span>
                )}
              </p>
            ))}
          </div>
        ))}
      </section>
    ))
  }
</div>

{
  usedTerms.length > 0 && (
    <script is:inline type="application/json" id="glossary-data" set:html={glossaryJson} />
  )
}
<div class="gloss-pop" id={GLOSS_POPOVER_ID} aria-live="polite" hidden></div>

<script>
  import '../scripts/glossary-popover';
</script>

<style>
  .lyrics {
    font-size: calc(var(--lyric-scale) * 1rem);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .part {
    position: relative;
    padding: 16px 20px 14px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface) 60%, transparent);
    animation: rise 0.55s var(--ease-out) both;
    animation-delay: calc(min(var(--i), 12) * 40ms);
  }
  /* Call & response: the lead sings from one side of the roda, the coro answers from the other. */
  .part.solo {
    margin-right: clamp(0px, 6vw, 64px);
    border-left: 3px solid var(--text);
  }
  .part.coro {
    margin-left: clamp(0px, 6vw, 64px);
    border-left: 3px solid var(--coro);
    background: color-mix(in srgb, var(--gold) 6%, var(--surface));
  }
  .label {
    display: flex;
    gap: 8px;
    align-items: baseline;
    margin-bottom: 8px;
    font: 400 var(--fs-micro)/1 var(--font-mono);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .coro .label {
    color: var(--coro);
  }
  .label .sub {
    letter-spacing: 0.1em;
  }
  .stanza + .stanza {
    margin-top: 16px;
  }
  .line {
    position: relative;
    margin: 0;
    padding: 4px 0;
    transition: opacity 0.3s;
  }
  .pt {
    display: block;
    font: 500 1.5em/1.28 var(--font-display);
    color: var(--solo);
  }
  .coro .pt,
  .coro-line .pt {
    color: var(--coro);
    font-weight: 600;
  }
  /* the coro answering inside a solo section */
  .coro-line {
    margin-left: clamp(16px, 6vw, 48px);
    padding-left: 12px;
    border-left: 2px solid color-mix(in srgb, var(--gold) 40%, transparent);
  }
  .tr {
    display: block;
    margin-top: 2px;
    font: 400 0.95em/1.4 var(--font-ui);
    color: var(--muted);
  }
  :global(.hide-translation) .tr {
    display: none;
  }
  .seek {
    float: right;
    min-width: 44px;
    min-height: 32px;
    margin: 2px 0 0 8px;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    background: transparent;
    color: var(--muted);
    font: 400 var(--fs-small)/1.4 var(--font-mono);
    cursor: pointer;
  }
  .seek:hover {
    color: var(--gold);
    border-color: var(--gold);
  }

  /* karaoke: the line being sung */
  :global(.synced) .line {
    opacity: 0.45;
  }
  :global(.synced) .line:global(.now) {
    opacity: 1;
  }
  .line:global(.now)::before {
    content: '';
    position: absolute;
    left: -21px;
    top: 4px;
    bottom: 4px;
    width: 3px;
    background: var(--terra);
  }
  .coro-line:global(.now)::before {
    left: -2px;
  }

  .pt :global(.gloss) {
    cursor: help;
    text-decoration: underline dotted color-mix(in srgb, currentColor 50%, transparent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }
  .pt :global(.gloss:focus-visible) {
    outline: 2px solid var(--gold);
    border-radius: 2px;
  }
  .gloss-pop {
    position: absolute;
    z-index: 30;
    max-width: min(320px, calc(100vw - 24px));
    padding: 12px 14px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--gold);
    box-shadow: 0 8px 24px -12px rgba(22, 48, 41, 0.35);
    font-size: 15px;
    line-height: 1.5;
    animation: rise 0.2s var(--ease-out);
  }
  .gloss-pop :global(span) {
    display: block;
  }
  .gloss-pop :global(a) {
    display: inline-block;
    margin-top: 8px;
    font: 400 var(--fs-micro)/1.4 var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
  }
  .gloss-pop :global(a:hover) {
    color: var(--gold);
  }
  .gloss-pop :global(strong) {
    display: block;
    font: 600 19px/1.2 var(--font-display);
    color: var(--gold);
  }
</style>
