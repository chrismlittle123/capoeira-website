---
import { getEntries, getEntry } from 'astro:content';
import { hookOf, mediaBadge, songUrl, type Song } from '../lib/songs';

interface Props {
  song: Song;
  i?: number;
  /** morph the title into the song page header (names must be unique per page) */
  morph?: boolean;
}
const { song, i = 0, morph = true } = Astro.props;
const badge = mediaBadge(song);
const type = (await getEntry(song.data.type))!;
const toques = await getEntries(song.data.toques);
---

<li style={`--i:${i}`}>
  <a class="card" href={songUrl(song.id)}>
    <div class="meta">
      <span class="chip chip-type" style={`--type-color:${type.data.color}`}>{type.data.name}</span>
      {badge && <span class="has-audio">{badge.icon} {badge.label}</span>}
    </div>
    <h3 style={morph ? `view-transition-name: song-${song.id}` : undefined}>{song.data.title}</h3>
    <p class="hook">{hookOf(song)}</p>
    {toques.length > 0 && <p class="toques">{toques.map((t) => t.data.name).join(' · ')}</p>}
  </a>
</li>

<style>
  .toques {
    margin: 12px 0 0;
    font: 400 var(--fs-micro)/1.5 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
</style>
