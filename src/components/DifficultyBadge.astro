---
import type { Difficulty } from '../lib/lyrics';

interface Props {
  difficulty: Difficulty;
}
const { difficulty: d } = Astro.props;
---

<span class="difficulty" title={`${d.label} — ${d.words} words to learn`}>
  <span class="dots" aria-hidden="true">{[1, 2, 3].map((i) => <i class:list={[i <= d.level && 'on']} />)}</span>
  {d.label}
</span>

<style>
  .difficulty {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font: 400 var(--fs-small) / 1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }
  .dots {
    display: inline-flex;
    gap: 3px;
  }
  .dots i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    border: 1px solid var(--gold);
  }
  .dots i.on {
    background: var(--gold);
  }
</style>
