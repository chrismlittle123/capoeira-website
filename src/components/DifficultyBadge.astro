---
// A song's difficulty: dots and label, with the word count on hover.
import type { Difficulty } from '../lib/lyrics/lyrics';
import LevelDots from './LevelDots.astro';

interface Props {
  difficulty: Difficulty;
}
const { difficulty: d } = Astro.props;
---

<span class="difficulty" title={`${d.label} — ${d.words} words to learn`}>
  <LevelDots level={d.level} />
  {d.label}
</span>

<style>
  .difficulty {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font: 400 var(--fs-small) / 1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }
</style>
