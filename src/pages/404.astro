---
import Base from '../layouts/Base.astro';
import Roda from '../components/Roda.astro';
---

<Base title="Not found">
  <div class="wrap lost">
    <div class="roda"><Roda /></div>
    <h1>Volta do mundo…</h1>
    <p class="muted">This page went for a walk around the roda and didn't come back.</p>
    <a class="btn btn-gold" href="/">Back to the songs</a>
  </div>
</Base>

<style>
  .lost {
    text-align: center;
    padding-top: 40px;
  }
  .roda {
    width: min(320px, 80vw);
    margin: 0 auto 8px;
  }
  h1 {
    font-size: clamp(36px, 8vw, 56px);
  }
</style>
