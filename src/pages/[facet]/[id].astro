---
import Base from '../../layouts/Base.astro';
import SongCard from '../../components/SongCard.astro';
import type { CollectionEntry } from 'astro:content';
import { getSongs, getTaxonomy, songsWith } from '../../lib/content/songs';
import { FACETS, TAXONOMY_KEYS, entryFacts, type TaxonomyKey } from '../../lib/content/facets';
import { facetUrl } from '../../lib/content/urls';

export async function getStaticPaths() {
  const paths = [];
  for (const key of TAXONOMY_KEYS) {
    for (const entry of await getTaxonomy(key)) {
      paths.push({ params: { facet: key, id: entry.id }, props: { key, entry } });
    }
  }
  return paths;
}
interface Props {
  key: TaxonomyKey;
  entry: CollectionEntry<TaxonomyKey>;
}
const { key, entry } = Astro.props;
const facet = FACETS[key];
const matching = songsWith(await getSongs(), key, entry.id);
const data = entry.data;
const aka = 'aka' in data && data.aka.length ? data.aka.join(', ') : undefined;
const emoji = 'emoji' in data ? data.emoji : undefined;
const facts = entryFacts(data);
---

<Base title={data.name} description={data.description ?? `Capoeira songs: ${data.name}`}>
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow"><a href={facetUrl(key)}>{facet.label}</a></p>
      <h1>
        {emoji && <span class="emoji" aria-hidden="true">{`${emoji} `}</span>}{data.name}
      </h1>
      {aka && <p class="muted">Also known as {aka}</p>}
      {facts.length > 0 && (
        <ul class="chips facts">
          {facts.map((f) => (
            <li class="chip">{f}</li>
          ))}
        </ul>
      )}
      {data.description && <p class="desc">{data.description}</p>}
    </header>
    <div class="corda" aria-hidden="true"></div>
    {
      matching.length ? (
        <ul class="song-grid stagger list">
          {matching.map((s, i) => (
            <SongCard song={s} i={i} />
          ))}
        </ul>
      ) : (
        <p class="empty">No songs here yet — vem camará, the roda is still forming.</p>
      )
    }
  </div>
</Base>

<style>
  .page-head {
    padding: 40px 0 24px;
    max-width: 720px;
  }
  .page-head h1 {
    font-size: clamp(40px, 8vw, 64px);
    margin: 10px 0 8px;
  }
  .emoji {
    display: inline-block;
    animation: wobble 2.8s ease-in-out infinite;
  }
  @keyframes wobble {
    0%, 100% { transform: rotate(-6deg); }
    50% { transform: rotate(6deg); }
  }
  .eyebrow a {
    text-decoration: none;
  }
  .facts {
    margin: 12px 0 4px;
  }
  .desc {
    font-size: 18px;
    color: var(--muted);
  }
  .corda {
    max-width: 160px;
    margin-bottom: 28px;
  }
  .empty {
    font: italic 20px var(--font-display);
    color: var(--muted);
  }
</style>
