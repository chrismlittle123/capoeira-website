---
import Base from '../../layouts/Base.astro';
import { FACETS, TAXONOMY_KEYS, getSongs, getTaxonomy, songsWith, entryFacts, type TaxonomyKey } from '../../lib/songs';
import { PAGES, facetUrl } from '../../lib/urls';

export function getStaticPaths() {
  return TAXONOMY_KEYS.map((key) => ({ params: { facet: key }, props: { key } }));
}
interface Props {
  key: TaxonomyKey;
}
const { key } = Astro.props;
const facet = FACETS[key];
const [songs, entries] = await Promise.all([getSongs(), getTaxonomy(key)]);
// entries that have songs first; empty ones stay listed (they explain the ontology) but dimmed
const items = entries
  .map((e) => ({ e, n: songsWith(songs, key, e.id).length }))
  .sort((a, b) => Number(b.n > 0) - Number(a.n > 0));
---

<Base title={facet.label} description={facet.blurb}>
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow"><a href={PAGES.browse}>Browse</a></p>
      <h1>{facet.label}</h1>
      <p class="muted">{facet.blurb}</p>
    </header>
    <ul class="entries stagger">
      {
        items.map(({ e, n }, i) => (
          <li style={`--i:${i}`}>
            <a class:list={['card', n === 0 && 'empty']} href={facetUrl(key, e.id)}>
              <div class="meta">
                {'emoji' in e.data && e.data.emoji && <span aria-hidden="true">{e.data.emoji}</span>}
                <span>{entryFacts(e.data).join(' · ')}</span>
                <span class="n">{n === 0 ? 'no songs yet' : `${n} ${n === 1 ? 'song' : 'songs'}`}</span>
              </div>
              <h3>{e.data.name}</h3>
              {e.data.description && <p class="desc">{e.data.description}</p>}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .page-head {
    padding: 40px 0 24px;
  }
  .page-head h1 {
    font-size: clamp(40px, 8vw, 64px);
    margin: 10px 0 8px;
  }
  .eyebrow a {
    text-decoration: none;
  }
  .entries {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 14px;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .desc {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
  }
  .n {
    margin-left: auto;
    white-space: nowrap;
  }
  .empty {
    opacity: 0.6;
  }
  .empty:hover {
    opacity: 1;
  }
</style>
