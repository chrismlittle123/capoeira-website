---
import Base from '../layouts/Base.astro';
import Search from '../components/Search.astro';
import Berimbau from '../components/Berimbau.astro';
import RhythmGrid from '../components/RhythmGrid.astro';
import SongCard from '../components/SongCard.astro';
import Icon from '../components/Icon.astro';
import { getSongs, getTaxonomy, facetIds, facetUrl } from '../lib/songs';

const [songs, toques, themes] = await Promise.all([getSongs(), getTaxonomy('toques'), getTaxonomy('themes')]);
const recent = [...songs].sort((a, b) => +b.data.added - +a.data.added).slice(0, 6);
const count = (key: 'toques' | 'themes', id: string) => songs.filter((s) => facetIds(s, key).includes(id)).length;
const usedToques = toques.map((t) => ({ t, n: count('toques', t.id) })).filter((x) => x.n);
const usedThemes = themes.map((t) => ({ t, n: count('themes', t.id) })).filter((x) => x.n);
const recordings = songs.reduce((n, s) => n + s.data.recordings.length, 0);
---

<Base bare>
  <div class="wrap">
    <section class="hero">
      <div class="hero-text">
        <p class="eyebrow">An open songbook · cantigas de capoeira</p>
        <h1>
          Every song in the <span class="roda-word">roda<span class="ring" aria-hidden="true"></span></span>.
        </h1>
        <p class="lede">
          Forgot the coro? Type any line you remember — in Portuguese or English — and get the{' '}
          <strong>lyrics</strong>, the <strong>translation</strong> and a <strong>recording</strong>.
        </p>
        <p class="stats mono">
          <span>{songs.length} songs</span>
          <span>{usedToques.length} toques</span>
          <span>{recordings} {recordings === 1 ? 'recording' : 'recordings'}</span>
        </p>
      </div>

      <div class="search-slot">
        <Search inline filters syncUrl />
      </div>
    </section>

    <div data-browse>
      <section class="toque-strip" aria-label="The berimbau">
        <div class="bw" aria-hidden="true"><Berimbau height={150} /></div>
        <RhythmGrid class="strip-grid" />
        <div class="quick">
          <button class="btn btn-gold au" type="button" data-random={JSON.stringify(songs.map((s) => s.id))}>
            <span class="au-icon"><Icon name="shuffle" size={16} /></span> Surprise me
          </button>
          <a class="btn" href="/songs/">All songs A–Z →</a>
        </div>
      </section>

      <div class="section-head">
        <h2>Recently added</h2>
        <a href="/songs/">See all →</a>
      </div>
      <ul class="song-grid stagger">
        {recent.map((s, i) => <SongCard song={s} i={i} />)}
      </ul>

      <div class="section-head">
        <h2>By toque</h2>
        <a href={facetUrl('toques')}>What's a toque? →</a>
      </div>
      <ul class="chips">
        {
          usedToques.map(({ t, n }) => (
            <li>
              <a class="chip" href={facetUrl('toques', t.id)}>
                {t.data.name} <span class="count">{n}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="section-head">
        <h2>By theme</h2>
        <a href={facetUrl('themes')}>All themes →</a>
      </div>
      <ul class="themes stagger">
        {
          usedThemes.map(({ t, n }, i) => (
            <li style={`--i:${i}`}>
              <a class="card theme" href={facetUrl('themes', t.id)}>
                <span class="emoji" aria-hidden="true">{t.data.emoji}</span>
                <span class="name">{t.data.name}</span>
                <span class="count">{n} {n === 1 ? 'song' : 'songs'}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Base>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-random]');
  btn?.addEventListener('click', () => {
    const ids: string[] = JSON.parse(btn.dataset.random!);
    const id = ids[Math.floor(Math.random() * ids.length)];
    btn.classList.remove('spinning');
    void btn.offsetWidth; // restart the animation
    btn.classList.add('spinning');
    const go = () => (location.href = `/songs/${id}/`);
    matchMedia('(prefers-reduced-motion: reduce)').matches ? go() : setTimeout(go, 600);
  });
  // coming Back from the random song restores this page from cache mid-cartwheel
  addEventListener('pageshow', () => btn?.classList.remove('spinning'));
</script>

<style>
  .hero {
    padding: clamp(24px, 6vh, 64px) 0 8px;
  }
  .hero-text {
    max-width: 720px;
  }
  h1 {
    margin: 14px 0 0;
    font-size: clamp(40px, 8vw, 68px);
    line-height: 1.02;
  }
  /* "roda" gets a hand-drawn circle around it, like people forming the roda */
  .roda-word {
    position: relative;
    display: inline-block;
    color: var(--gold);
  }
  .ring {
    position: absolute;
    inset: -0.04em -0.2em 0;
    border: 2px solid var(--gold);
    border-radius: 50%;
    transform: rotate(-4deg);
    opacity: 0.55;
    animation: draw 1.2s 0.3s var(--ease-out) both;
  }
  @keyframes draw {
    from {
      opacity: 0;
      transform: rotate(-120deg) scale(0.6);
    }
  }
  .lede {
    max-width: 600px;
    margin: 18px 0 0;
    color: var(--muted);
    font-size: 18px;
    line-height: 1.65;
  }
  .lede strong {
    color: var(--text);
    font-weight: 600;
  }
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    margin: 16px 0 0;
    font-size: var(--fs-small);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .search-slot {
    margin-top: 28px;
    max-width: 760px;
  }

  .toque-strip {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas: 'bw grid' 'bw quick';
    gap: 18px 28px;
    align-items: center;
    margin-top: 28px;
    padding: 22px 24px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface) 60%, transparent);
  }
  .bw {
    grid-area: bw;
  }
  .toque-strip :global(.strip-grid) {
    grid-area: grid;
  }
  .quick {
    grid-area: quick;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  @media (max-width: 640px) {
    .toque-strip {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'grid' 'quick';
      padding: 18px 16px;
    }
    .bw {
      display: none;
    }
  }

  .au-icon {
    display: inline-flex;
  }
  .au.spinning .au-icon {
    animation: au 0.6s var(--ease-ginga) forwards;
  }
  /* aú — the cartwheel */
  @keyframes au {
    0% { transform: translate(0, 0) rotate(0); }
    50% { transform: translate(10px, -12px) rotate(200deg); }
    100% { transform: translate(20px, 0) rotate(360deg); }
  }

  .themes {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
    gap: 10px;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  @media (max-width: 480px) {
    .themes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .theme {
      padding: 12px;
      column-gap: 8px;
    }
  }
  .theme {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 12px;
    align-items: center;
    padding: 14px 16px;
  }
  .theme:hover .emoji {
    animation: wobble 0.6s var(--ease-ginga);
  }
  @keyframes wobble {
    30% { transform: rotate(-14deg) scale(1.15); }
    60% { transform: rotate(8deg); }
  }
  .emoji {
    grid-row: span 2;
    font-size: 24px;
  }
  .name {
    min-width: 0;
    font: 600 17px/1.2 var(--font-display);
    overflow-wrap: anywhere;
  }
  .theme .count {
    font: 400 var(--fs-micro)/1.6 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
</style>
