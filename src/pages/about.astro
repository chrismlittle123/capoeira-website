---
import Base from '../layouts/Base.astro';
import { getSongs } from '../lib/songs';
import { SITE } from '../site.config';

const songs = await getSongs();
const recordings = songs.reduce((n, s) => n + s.data.recordings.length, 0);
---

<Base title="About & open data" description="About this songbook and how to use its open data.">
  <div class="wrap prose">
    <p class="eyebrow">Sobre</p>
    <h1>An open songbook for the roda</h1>
    <p>
      This songbook is kept by <strong>{SITE.groupName}</strong> so that anyone — a new student, a visiting capoeirista, or
      a mestre who forgot the second verse — can find a song in seconds on their phone, read the words, understand them,
      and hear how it goes.
    </p>
    <p>
      It currently holds <strong>{songs.length}</strong> songs and <strong>{recordings}</strong> recordings. Songs vary
      from roda to roda: these are the versions we sing.
    </p>

    <h2>Works offline</h2>
    <p>
      Every song you open is saved on your phone, so lyrics still load in an academy basement with no signal. On iPhone
      tap <em>Share → Add to Home Screen</em>; on Android, <em>Install app</em>.
    </p>

    <h2>Open data</h2>
    <p>
      The whole songbook is available as structured data under <a href={SITE.licenseUrl}>{SITE.license}</a>. Build
      something with it — flashcards, a printed songbook, a berimbau trainer.
    </p>
    <ul>
      <li><a href="/api/songs.json"><code>/api/songs.json</code></a> — every song with structured lyrics (sections, lines, translations, timestamps), recordings and references</li>
      <li><a href="/api/ontology.json"><code>/api/ontology.json</code></a> — song types, toques, themes, people, places and glossary</li>
      <li>Each song page also embeds <a href="https://schema.org/MusicComposition">schema.org</a> JSON-LD.</li>
    </ul>

    <h2>Corrections</h2>
    <p>
      Heard a verse differently? Spotted a mistranslation? Tell us after training — songs are living things and we love
      learning other versions.
    </p>
  </div>
</Base>

<style>
  .prose {
    max-width: 720px;
    padding-top: 40px;
  }
  h1 {
    font-size: clamp(38px, 7vw, 58px);
    margin: 10px 0 18px;
  }
  h2 {
    font-size: 26px;
    margin: 36px 0 8px;
  }
  p,
  li {
    color: var(--muted);
    font-size: 17px;
  }
  strong,
  em {
    color: var(--text);
  }
  code {
    color: var(--gold);
    font-size: 0.92em;
  }
  li + li {
    margin-top: 6px;
  }
</style>
