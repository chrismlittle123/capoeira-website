---
import Base from '../layouts/Base.astro';
import { getSongs, recordingCount } from '../lib/content/songs';
import { plural } from '../lib/text';
import { SITE } from '../site.config';
import { ONTOLOGY_JSON_URL, SONGS_JSON_URL } from '../lib/content/urls';

const songs = await getSongs();
const recordings = recordingCount(songs);
---

<Base title="About & open data" description="About this songbook and how to use its open data.">
  <div class="wrap prose">
    <p class="eyebrow kicker">Sobre</p>
    <h1>An open songbook for the roda</h1>
    <p>
      This songbook exists so that anyone — a new student, a visiting capoeirista, or
      a mestre who forgot the second verse — can find a song in seconds on their phone, read the words, understand them,
      and hear how it goes.
    </p>
    <p>
      It currently holds <strong>{plural(songs.length, 'song', 'songs')}</strong> and
      <strong>{plural(recordings, 'recording', 'recordings')}</strong> (audio and video). Songs vary
      from roda to roda: these are common versions, not the only ones.
    </p>

    <h2>Works offline</h2>
    <p>
      Every song you open is saved on your phone, so lyrics still load in an academy basement with no signal. On iPhone
      tap <em>Share → Add to Home Screen</em>; on Android, <em>Install app</em>.
    </p>

    <h2>Open data</h2>
    <p>
      The whole songbook is available as structured data under <a href={SITE.licenseUrl}>{SITE.license}</a>. Build
      something with it — flashcards, a printed songbook, a berimbau trainer.
    </p>
    <ul>
      <li><a href={SONGS_JSON_URL}><code>{SONGS_JSON_URL}</code></a> — every song with structured lyrics (sections, lines, translations, timestamps), recordings and references</li>
      <li><a href={ONTOLOGY_JSON_URL}><code>{ONTOLOGY_JSON_URL}</code></a> — themes, people, places and glossary</li>
      <li>Each song page also embeds <a href="https://schema.org/MusicComposition">schema.org</a> JSON-LD.</li>
    </ul>

    <h2>Corrections</h2>
    <p>
      Heard a verse differently? Spotted a mistranslation? Songs are living things — corrections and other versions are
      always welcome.
    </p>
  </div>
</Base>

<style>
  .prose {
    max-width: 720px;
    padding-top: 40px;
  }
  h1 {
    font-size: clamp(38px, 7vw, 58px);
    margin: 10px 0 18px;
  }
  h2 {
    font-size: 26px;
    margin: 36px 0 8px;
  }
  p:not(.kicker),
  li {
    color: var(--muted);
    font-size: 17px;
  }
  strong,
  em {
    color: var(--text);
  }
  code {
    color: var(--gold);
    font-size: 0.92em;
  }
  li + li {
    margin-top: 6px;
  }
</style>
