---
import Base from '../../layouts/Base.astro';
import { getSongs, getTaxonomy, songsWith } from '../../lib/content/songs';
import { FACETS, TAXONOMY_KEYS } from '../../lib/content/facets';
import { facetUrl } from '../../lib/content/urls';

const songs = await getSongs();
const facets = await Promise.all(
  TAXONOMY_KEYS.map(async (key) => ({
    key,
    ...FACETS[key],
    items: (await getTaxonomy(key))
      .map((e) => ({ e, n: songsWith(songs, key, e.id).length }))
      .filter((x) => x.n),
  })),
);
---

<Base title="Browse" description="Browse capoeira songs by theme, people and places.">
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">Explore</p>
      <h1>Browse the songbook</h1>
    </header>
    {
      facets
        .filter((f) => f.items.length)
        .map((f) => (
          <section>
            <div class="section-head">
              <h2>{f.label}</h2>
              <a href={facetUrl(f.key)}>Details →</a>
            </div>
            <p class="muted blurb">{f.blurb}</p>
            <ul class="chips">
              {f.items.map(({ e, n }) => (
                <li>
                  <a class="chip" href={facetUrl(f.key, e.id)}>
                    {e.data.name} <span class="count">{n}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
    }
  </div>
</Base>

<style>
  .page-head {
    padding: 40px 0 0;
  }
  .page-head h1 {
    font-size: clamp(40px, 8vw, 64px);
    margin-top: 10px;
  }
  .blurb {
    margin: -6px 0 14px;
  }
</style>
