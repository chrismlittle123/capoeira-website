---
import { getEntries } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Lyrics from '../../components/Lyrics.astro';
import MediaPlayer from '../../components/MediaPlayer.astro';
import SongCard from '../../components/SongCard.astro';
import Icon from '../../components/Icon.astro';
import { getSongs, getNames, lyricsOf, facetIds, type Song, type TaxonomyKey } from '../../lib/songs';
import { facetUrl, songUrl } from '../../lib/urls';
import { allLines, difficulty, hasTranslation, plainText } from '../../lib/lyrics';
import DifficultyBadge from '../../components/DifficultyBadge.astro';
import { SITE } from '../../site.config';

export async function getStaticPaths() {
  const songs = await getSongs();
  return songs.map((song, i) => ({
    params: { slug: song.id },
    props: { song, prev: songs[i - 1], next: songs[i + 1] },
  }));
}

interface Props {
  song: Song;
  prev?: Song;
  next?: Song;
}
const { song, prev, next } = Astro.props;
const d = song.data;
const sections = lyricsOf(song);
const level = difficulty(sections);
const names = await getNames();
const people = await getEntries(d.people);

// Related: explicit links first, then shared themes/people/places.
const all = await getSongs();
const explicit = new Set(d.related.map((r) => r.id));
const WEIGHTS: [TaxonomyKey, number][] = [['themes', 3], ['people', 3], ['places', 2]];
const score = (s: Song) =>
  (explicit.has(s.id) || s.data.related.some((r) => r.id === song.id) ? 10 : 0) +
  WEIGHTS.reduce((n, [k, w]) => n + w * facetIds(s, k).filter((id) => facetIds(song, k).includes(id)).length, 0);
const related = all
  .filter((s) => s.id !== song.id)
  .map((s) => ({ s, n: score(s) }))
  .filter((x) => x.n >= 2)
  .sort((a, b) => b.n - a.n)
  .slice(0, 4)
  .map((x) => x.s);

const STYLE_NAMES = { angola: 'Angola', regional: 'Regional', contemporanea: 'Contemporânea' } as const;
type Fact = { label: string; key?: TaxonomyKey; items: { id: string; name: string }[] };
const allFacts: Fact[] = [
  { label: 'Themes', key: 'themes', items: d.themes.map((r) => ({ id: r.id, name: names.themes[r.id] })) },
  { label: 'People', key: 'people', items: d.people.map((r) => ({ id: r.id, name: names.people[r.id] })) },
  { label: 'Places', key: 'places', items: d.places.map((r) => ({ id: r.id, name: names.places[r.id] })) },
  { label: 'Style', items: d.styles.map((s) => ({ id: s, name: STYLE_NAMES[s] })) },
];
const facts = allFacts.filter((f) => f.items.length);

const originText =
  d.origin === 'traditional'
    ? 'Traditional'
    : d.origin === 'composed'
      ? d.composer
        ? `By ${d.composer}`
        : 'Composed (author unknown)'
      : d.composer
        ? `By ${d.composer}`
        : 'Origin unknown';
const nonEmpty = <T,>(a: T[]) => (a.length ? a : undefined);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MusicComposition',
  name: d.title,
  alternateName: nonEmpty(d.alternateTitles),
  genre: 'Capoeira',
  inLanguage: d.language,
  composer: d.composer ? { '@type': 'Person', name: d.composer } : undefined,
  lyrics: { '@type': 'CreativeWork', text: plainText(sections), inLanguage: d.language },
  about: nonEmpty(people.map((p) => ({ '@type': 'Person', name: p.data.name }))),
  recordedAs: nonEmpty(
    d.recordings.map((r) => ({
      '@type': 'MusicRecording',
      name: r.title ?? d.title,
      byArtist: r.performer ? { '@type': 'MusicGroup', name: r.performer } : undefined,
      ...(r.kind === 'youtube'
        ? {
            video: {
              '@type': 'VideoObject',
              name: r.title ?? d.title,
              embedUrl: `https://www.youtube-nocookie.com/embed/${r.videoId}`,
              thumbnailUrl: `https://i.ytimg.com/vi/${r.videoId}/hqdefault.jpg`,
              url: r.src,
            },
          }
        : { audio: { '@type': 'AudioObject', contentUrl: new URL(r.src, Astro.site).href } }),
    })),
  ),
  license: SITE.licenseUrl,
  url: new URL(songUrl(song.id), Astro.site).href,
};
const description =
  d.summary || `Capoeira song: ${allLines(sections).slice(0, 2).map((l) => l.text).join(' / ')}`;
const translated = hasTranslation(sections);
---

<Base title={d.title} description={description} jsonLd={jsonLd} type="music.song">
  <article class="wrap song">
    <header class="head">
      <h1 style={`view-transition-name: song-${song.id}`}>{d.title}</h1>
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/songs/">Songs</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{d.title}</span>
      </nav>
      <p class="meta mono">
        <DifficultyBadge difficulty={level} />
        <span>{originText}</span>
      </p>
      {d.alternateTitles.length > 0 && <p class="alt">also sung as {d.alternateTitles.map((t) => `“${t}”`).join(', ')}</p>}
      {d.summary && <p class="summary">{d.summary}</p>}
    </header>

    {d.recordings.length > 0 && <MediaPlayer recordings={d.recordings} songTitle={d.title} />}

    <div class="toolbar" role="toolbar" aria-label="Reading options">
      {
        translated && (
          <button class="icon-btn" type="button" data-tool="translation" aria-pressed="true" aria-label="Show translation" title="Hide translation">
            <Icon name="translate" />
          </button>
        )
      }
      <button class="icon-btn" type="button" data-tool="smaller" aria-label="Smaller text" title="Smaller text">
        <span class="aa small" aria-hidden="true">A</span>
      </button>
      <button class="icon-btn" type="button" data-tool="bigger" aria-label="Bigger text" title="Bigger text">
        <span class="aa big" aria-hidden="true">A</span>
      </button>
      <button class="icon-btn" type="button" data-tool="awake" aria-pressed="false" aria-label="Keep screen on" title="Keep screen on" hidden>
        <Icon name="eye" />
      </button>
      <button class="icon-btn" type="button" data-tool="share" aria-label="Share" title="Share">
        <Icon name="share" />
      </button>
      <span class="toast" data-toast aria-live="polite"></span>
    </div>

    <div class="layout">
      <div class="main-col">
        {
          translated && !d.translationReviewed && (
            <p class="draft-note">
              <span class="eyebrow">Draft translation</span> The English is a first pass and hasn't been checked yet —
              corrections welcome.
            </p>
          )
        }
        <Lyrics sections={sections} />
        {
          d.about && (
            <aside class="about">
              <h2>About this song</h2>
              {d.about
                .trim()
                .split(/\n\s*\n/)
                .map((p) => (
                  <p>{p.replace(/\s*\n\s*/g, ' ')}</p>
                ))}
            </aside>
          )
        }
        {
          d.sources.length > 0 && (
            <aside class="sources">
              <h2>Other versions</h2>
              <ul>
                {d.sources.map((u) => (
                  <li>
                    <a href={u} rel="noopener" target="_blank">
                      {new URL(u).hostname.replace(/^www\./, '')}
                    </a>
                  </li>
                ))}
              </ul>
            </aside>
          )
        }
      </div>

      <aside class="facts">
        <dl>
          {
            facts.map((f) => (
              <div>
                <dt>{f.label}</dt>
                <dd>
                  <ul class="chips">
                    {f.items.map((it) => (
                      <li>{f.key ? <a class="chip" href={facetUrl(f.key, it.id)}>{it.name}</a> : <span class="plain">{it.name}</span>}</li>
                    ))}
                  </ul>
                </dd>
              </div>
            ))
          }
          <div>
            <dt>Origin</dt>
            <dd>{d.origin === 'traditional' ? 'Traditional (domínio público)' : originText}</dd>
          </div>
        </dl>
      </aside>
    </div>

    {
      related.length > 0 && (
        <section>
          <div class="section-head">
            <h2>Sing next</h2>
          </div>
          <ul class="song-grid stagger">
            {related.map((s, i) => (
              <SongCard song={s} i={i} />
            ))}
          </ul>
        </section>
      )
    }

    <nav class="pager" aria-label="Previous and next song">
      {prev ? <a href={songUrl(prev.id)} rel="prev">← {prev.data.title}</a> : <span></span>}
      {next && <a href={songUrl(next.id)} rel="next">{next.data.title} →</a>}
    </nav>
  </article>
</Base>

<script>
  import '../../scripts/song-page';
</script>

<style>
  .head {
    padding-bottom: 22px;
    margin-bottom: 24px;
    border-bottom: 1px solid var(--line);
  }
  .head h1 {
    margin: 8px 0 18px;
    font-size: clamp(42px, 9vw, 68px);
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font: 400 0.72rem/1.4 var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .crumbs a {
    text-decoration: none;
  }
  @media (max-width: 640px) {
    .crumbs {
      align-items: center;
      gap: 0 8px;
    }
    .crumbs a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }
  .crumbs a:hover {
    color: var(--text);
  }
  .crumbs [aria-current] {
    color: var(--gold);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 16px;
    margin: 14px 0 0;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .alt {
    margin: 6px 0 0;
    color: var(--muted);
    font-style: italic;
    font-family: var(--font-display);
  }
  .summary {
    max-width: 620px;
    margin: 14px 0 0;
    font-size: 18px;
    color: var(--text);
  }

  .toolbar {
    position: sticky;
    top: 92px;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 2px;
    width: fit-content;
    margin: 20px 0 20px auto;
    padding: 3px;
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid var(--line);
  }
  @media (max-width: 860px) {
    /* on phones a pinned toolbar would sit on top of the lyrics */
    .toolbar {
      position: static;
    }
  }
  .icon-btn:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .plain {
    display: inline-block;
    padding: 4px 0;
    font: 400 0.75rem/1.4 var(--font-mono);
    color: var(--muted);
  }
  .aa {
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1;
  }
  .aa.small {
    font-size: 14px;
  }
  .aa.big {
    font-size: 20px;
  }
  .toast {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    background: var(--text);
    color: var(--bg);
    font: 400 var(--fs-small)/1.4 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 0.2s, transform 0.3s var(--ease-out);
    pointer-events: none;
  }
  .toast:global(.show) {
    opacity: 1;
    transform: none;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: 40px;
    align-items: start;
  }
  @media (max-width: 860px) {
    .layout {
      grid-template-columns: 1fr;
    }
  }
  .about {
    margin-top: 28px;
    padding: 18px 22px;
    border-left: 3px solid var(--green);
    background: color-mix(in srgb, var(--surface) 60%, transparent);
    border-radius: 0 var(--radius) var(--radius) 0;
  }
  .about h2 {
    font: 400 var(--fs-micro)/1.4 var(--font-mono);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--green);
  }
  .about p {
    margin: 10px 0 0;
    line-height: 1.7;
  }
  .draft-note {
    margin: 0 0 14px;
    padding: 10px 14px;
    border: 1px dashed color-mix(in srgb, var(--gold) 50%, var(--line));
    border-radius: var(--radius);
    font-size: 14px;
    color: var(--muted);
  }
  .draft-note .eyebrow {
    display: inline;
    margin-right: 8px;
  }
  .sources {
    margin-top: 20px;
  }
  .sources h2 {
    font: 400 var(--fs-micro)/1.4 var(--font-mono);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .sources a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .sources ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
    font: 400 0.75rem/1.5 var(--font-mono);
  }
  .facts {
    position: sticky;
    top: 150px;
  }
  @media (max-width: 860px) {
    .facts {
      position: static;
    }
  }
  dl {
    margin: 0;
    display: grid;
    gap: 18px;
  }
  dt {
    margin-bottom: 8px;
    font: 400 var(--fs-micro)/1 var(--font-mono);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--gold);
  }
  dd {
    margin: 0;
    font-size: 15px;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 48px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    font: 400 0.72rem/1.4 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .pager a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--muted);
    text-decoration: none;
  }
  .pager a:hover {
    color: var(--gold);
  }
</style>
