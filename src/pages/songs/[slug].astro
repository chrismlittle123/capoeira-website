---
import { getEntries, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Lyrics from '../../components/Lyrics.astro';
import AudioPlayer from '../../components/AudioPlayer.astro';
import SongCard from '../../components/SongCard.astro';
import Icon from '../../components/Icon.astro';
import Berimbau from '../../components/Berimbau.astro';
import { getSongs, getNames, lyricsOf, facetIds, facetUrl, songUrl, type Song, type TaxonomyKey } from '../../lib/songs';
import { allLines, hasTranslation } from '../../lib/lyrics';
import { SITE } from '../../site.config';

export async function getStaticPaths() {
  const songs = await getSongs();
  return songs.map((song, i) => ({
    params: { slug: song.id },
    props: { song, prev: songs[i - 1], next: songs[i + 1] },
  }));
}

interface Props {
  song: Song;
  prev?: Song;
  next?: Song;
}
const { song, prev, next } = Astro.props;
const d = song.data;
const sections = lyricsOf(song);
const names = await getNames();
const type = (await getEntry(d.type))!;
const [toques, people] = await Promise.all([getEntries(d.toques), getEntries(d.people)]);

// Related: explicit links first, then songs sharing toques/themes.
const all = await getSongs();
const explicit = new Set(d.related.map((r) => r.id));
const score = (s: Song) =>
  (explicit.has(s.id) || s.data.related.some((r) => r.id === song.id) ? 10 : 0) +
  (['themes', 'toques', 'people', 'places'] as TaxonomyKey[]).reduce(
    (n, k) => n + facetIds(s, k).filter((id) => facetIds(song, k).includes(id)).length,
    0,
  );
const related = all
  .filter((s) => s.id !== song.id)
  .map((s) => ({ s, n: score(s) }))
  .filter((x) => x.n > 0)
  .sort((a, b) => b.n - a.n)
  .slice(0, 4)
  .map((x) => x.s);

const STYLE_NAMES = { angola: 'Angola', regional: 'Regional', contemporanea: 'Contemporânea' } as const;
type Fact = { label: string; key?: TaxonomyKey; items: { id: string; name: string }[] };
const allFacts: Fact[] = [
  { label: 'Toques', key: 'toques', items: d.toques.map((r) => ({ id: r.id, name: names.toques[r.id] })) },
  { label: 'Themes', key: 'themes', items: d.themes.map((r) => ({ id: r.id, name: names.themes[r.id] })) },
  { label: 'People', key: 'people', items: d.people.map((r) => ({ id: r.id, name: names.people[r.id] })) },
  { label: 'Places', key: 'places', items: d.places.map((r) => ({ id: r.id, name: names.places[r.id] })) },
  { label: 'Style', items: d.styles.map((s) => ({ id: s, name: STYLE_NAMES[s] })) },
];
const facts = allFacts.filter((f) => f.items.length);

const plainLyrics = sections
  .map((s) => `${s.label}\n${s.stanzas.map((st) => st.map((l) => l.text).join('\n')).join('\n\n')}`)
  .join('\n\n');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MusicComposition',
  name: d.title,
  alternateName: d.alternateTitles,
  genre: ['Capoeira', type.data.name],
  inLanguage: d.language,
  composer: d.composer ? { '@type': 'Person', name: d.composer } : undefined,
  lyrics: { '@type': 'CreativeWork', text: plainLyrics, inLanguage: d.language },
  about: people.map((p) => ({ '@type': 'Person', name: p.data.name })),
  recordedAs: d.recordings.map((r) => ({
    '@type': 'MusicRecording',
    name: r.title ?? d.title,
    byArtist: r.performer ? { '@type': 'MusicGroup', name: r.performer } : undefined,
    audio: { '@type': 'AudioObject', contentUrl: new URL(r.file, Astro.site).href },
  })),
  license: SITE.licenseUrl,
  url: new URL(songUrl(song.id), Astro.site).href,
};
const description =
  d.summary || `${type.data.name}: ${allLines(sections).slice(0, 2).map((l) => l.text).join(' / ')}`;
const translated = hasTranslation(sections);
---

<Base title={d.title} description={description} jsonLd={jsonLd}>
  <article class="wrap song">
    <a class="back" href="/"><Icon name="back" size={18} /> All songs</a>

    <header class="head">
      <div class="head-text">
        <a class="chip chip-type" href={facetUrl('songTypes', type.id)}>{type.data.name}</a>
        <h1 style={`view-transition-name: song-${song.id}`}>{d.title}</h1>
        {d.alternateTitles.length > 0 && <p class="alt">also sung as {d.alternateTitles.map((t) => `“${t}”`).join(', ')}</p>}
        {d.summary && <p class="summary">{d.summary}</p>}
      </div>
      <div class="head-art" aria-hidden="true"><Berimbau height={190} /></div>
    </header>

    {d.recordings.length > 0 && <AudioPlayer recordings={d.recordings} songTitle={d.title} />}

    <div class="toolbar" role="toolbar" aria-label="Reading options">
      {
        translated && (
          <button class="icon-btn" type="button" data-tool="translation" aria-pressed="true" title="Show translation">
            <Icon name="translate" />
            <span class="sr-only">Show translation</span>
          </button>
        )
      }
      <button class="icon-btn" type="button" data-tool="smaller" title="Smaller text">
        <span class="aa small">A</span><span class="sr-only">Smaller text</span>
      </button>
      <button class="icon-btn" type="button" data-tool="bigger" title="Bigger text">
        <span class="aa big">A</span><span class="sr-only">Bigger text</span>
      </button>
      <button class="icon-btn" type="button" data-tool="awake" aria-pressed="false" title="Keep screen on" hidden>
        <Icon name="eye" /><span class="sr-only">Keep screen on</span>
      </button>
      <button class="icon-btn" type="button" data-tool="share" title="Share">
        <Icon name="share" /><span class="sr-only">Share</span>
      </button>
      <span class="toast" data-toast aria-live="polite"></span>
    </div>

    <div class="layout">
      <div class="main-col">
        <Lyrics sections={sections} />
        {
          d.about && (
            <aside class="about">
              <h2>About this song</h2>
              {d.about
                .trim()
                .split(/\n\s*\n/)
                .map((p) => (
                  <p>{p.replace(/\s*\n\s*/g, ' ')}</p>
                ))}
            </aside>
          )
        }
      </div>

      <aside class="facts">
        <dl>
          {
            facts.map((f) => (
              <div>
                <dt>{f.label}</dt>
                <dd>
                  <ul class="chips">
                    {f.items.map((it) => (
                      <li>{f.key ? <a class="chip" href={facetUrl(f.key, it.id)}>{it.name}</a> : <span class="chip">{it.name}</span>}</li>
                    ))}
                  </ul>
                </dd>
              </div>
            ))
          }
          <div>
            <dt>Origin</dt>
            <dd>{d.origin === 'traditional' ? 'Traditional (domínio público)' : d.composer ?? d.origin}</dd>
          </div>
        </dl>
        {
          toques.length > 0 && (
            <div class="toque-note">
              <strong>{toques[0].data.name}</strong>
              <p>{toques[0].data.description}</p>
            </div>
          )
        }
      </aside>
    </div>

    {
      related.length > 0 && (
        <section>
          <div class="section-head">
            <h2>Sing next</h2>
          </div>
          <ul class="song-grid stagger">
            {related.map((s, i) => (
              <SongCard song={s} typeName={names.songTypes[s.data.type.id]} i={i} />
            ))}
          </ul>
        </section>
      )
    }

    <nav class="pager" aria-label="Previous and next song">
      {prev ? <a href={songUrl(prev.id)} rel="prev">← {prev.data.title}</a> : <span></span>}
      {next && <a href={songUrl(next.id)} rel="next">{next.data.title} →</a>}
    </nav>
  </article>
</Base>

<script>
  const root = document.documentElement;
  const lyrics = document.querySelector<HTMLElement>('[data-lyrics]')!;
  const toast = document.querySelector<HTMLElement>('[data-toast]')!;
  const tool = (name: string) => document.querySelector<HTMLButtonElement>(`[data-tool="${name}"]`);
  const store = {
    get: (k: string) => {
      try {
        return localStorage.getItem(k);
      } catch {
        return null;
      }
    },
    set: (k: string, v: string) => {
      try {
        localStorage.setItem(k, v);
      } catch {}
    },
  };
  const say = (msg: string) => {
    toast.textContent = msg;
    toast.classList.add('show');
    setTimeout(() => toast.classList.remove('show'), 1800);
  };

  // translation
  const tr = tool('translation');
  const setTr = (on: boolean) => {
    lyrics.classList.toggle('hide-translation', !on);
    tr?.setAttribute('aria-pressed', String(on));
    store.set('translation', on ? '1' : '0');
  };
  setTr(store.get('translation') !== '0');
  tr?.addEventListener('click', () => setTr(tr.getAttribute('aria-pressed') !== 'true'));

  // text size
  let scale = Number(store.get('lyric-scale') ?? 1) || 1;
  const setScale = (s: number) => {
    scale = Math.min(1.8, Math.max(0.8, Math.round(s * 10) / 10));
    root.style.setProperty('--lyric-scale', String(scale));
    store.set('lyric-scale', String(scale));
  };
  setScale(scale);
  tool('smaller')?.addEventListener('click', () => setScale(scale - 0.1));
  tool('bigger')?.addEventListener('click', () => setScale(scale + 0.1));

  // keep the screen awake while reading in the roda
  const awake = tool('awake');
  let lock: WakeLockSentinel | null = null;
  if ('wakeLock' in navigator && awake) {
    awake.hidden = false;
    const request = async () => {
      try {
        lock = await navigator.wakeLock.request('screen');
        awake.setAttribute('aria-pressed', 'true');
        lock.addEventListener('release', () => awake.setAttribute('aria-pressed', 'false'));
      } catch {}
    };
    awake.addEventListener('click', async () => {
      if (lock && !lock.released) {
        await lock.release();
        lock = null;
        say('Screen can sleep');
      } else {
        await request();
        say('Screen stays on');
      }
    });
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible' && awake.getAttribute('aria-pressed') === 'true') request();
    });
  }

  // share
  tool('share')?.addEventListener('click', async () => {
    const data = { title: document.title, url: location.href };
    try {
      if (navigator.share) await navigator.share(data);
      else {
        await navigator.clipboard.writeText(location.href);
        say('Link copied');
      }
    } catch {}
  });

  // remember recently viewed songs
  try {
    const id = location.pathname.split('/').filter(Boolean).pop()!;
    const seen: string[] = JSON.parse(store.get('recent') ?? '[]').filter((x: string) => x !== id);
    store.set('recent', JSON.stringify([id, ...seen].slice(0, 12)));
  } catch {}
</script>

<style>
  .song {
    padding-top: 20px;
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--muted);
    font-size: 15px;
    text-decoration: none;
  }
  .back:hover {
    color: var(--text);
  }
  .back:hover :global(svg) {
    animation: nudge 0.5s var(--ease-ginga);
  }
  @keyframes nudge {
    50% { transform: translateX(-4px); }
  }
  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin: 18px 0 22px;
  }
  .head h1 {
    margin: 12px 0 6px;
    font-size: clamp(42px, 10vw, 76px);
    font-weight: 700;
  }
  .alt {
    margin: 0;
    color: var(--muted);
    font-style: italic;
    font-family: var(--font-display);
  }
  .summary {
    max-width: 560px;
    margin: 12px 0 0;
    font-size: 18px;
    color: var(--muted);
  }
  .head-art {
    flex: none;
    margin-right: 12px;
  }
  @media (max-width: 640px) {
    .head-art {
      display: none;
    }
  }

  .toolbar {
    position: sticky;
    top: 72px;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 2px;
    width: fit-content;
    margin: 18px 0 18px auto;
    padding: 4px;
    border-radius: 99px;
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }
  .aa {
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1;
  }
  .aa.small {
    font-size: 15px;
  }
  .aa.big {
    font-size: 22px;
  }
  .toast {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    padding: 6px 12px;
    border-radius: 99px;
    background: var(--gold);
    color: var(--gold-ink);
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 0.2s, transform 0.3s var(--ease-ginga);
    pointer-events: none;
  }
  .toast:global(.show) {
    opacity: 1;
    transform: none;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: 36px;
    align-items: start;
  }
  @media (max-width: 860px) {
    .layout {
      grid-template-columns: 1fr;
    }
  }
  .about {
    margin-top: 28px;
    padding: 20px 22px;
    border-left: 3px solid var(--green);
    background: color-mix(in srgb, var(--green) 8%, transparent);
    border-radius: 0 var(--radius) var(--radius) 0;
  }
  .about h2 {
    font-size: 22px;
    margin-bottom: 4px;
  }
  .about p {
    margin: 10px 0 0;
    color: var(--muted);
  }
  .facts {
    position: sticky;
    top: 140px;
  }
  dl {
    margin: 0;
    display: grid;
    gap: 16px;
  }
  dt {
    margin-bottom: 6px;
    font: 600 11px/1 var(--font-ui);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--faint);
  }
  dd {
    margin: 0;
    font-size: 15px;
  }
  .toque-note {
    margin-top: 22px;
    padding: 14px 16px;
    border-radius: var(--radius);
    background: var(--surface-2);
    font-size: 14px;
  }
  .toque-note p {
    margin: 4px 0 0;
    color: var(--muted);
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 48px;
    font-size: 15px;
  }
  .pager a {
    color: var(--muted);
  }
</style>
